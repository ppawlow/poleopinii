// rm-post.js
require("dotenv").config();
const readline = require("readline");
const mongoose = require("mongoose");
const { Post, rmPost } = require("./tools/db");

const targetId = process.argv[2];

if (!targetId) {
  console.error("Użycie: node rm-post.js <POST_ID>");
  console.error("Przykład: node rm-post.js 6afb3c5339b5a8838851ae37");
  process.exit(1);
}

function askConfirmation(question) {
  const rl = readline.createInterface({
    input: process.stdin,
    output: process.stdout,
  });
  return new Promise((resolve) => {
    rl.question(question, (answer) => {
      rl.close();
      resolve(answer.trim().toLowerCase());
    });
  });
}

async function run() {
  try {
    if (!mongoose.Types.ObjectId.isValid(targetId)) {
      console.error(`❌ Błąd: Podany identyfikator "${targetId}" nie jest poprawnym ObjectId.`);
      process.exit(1);
    }

    await mongoose.connect(
      process.env.MONGODB_URI || "mongodb://localhost:27017/test"
    );

    const post = await Post.findById(targetId);

    if (!post) {
      console.error(`⚠️  Nie znaleziono posta o ID: "${targetId}"`);
      await mongoose.disconnect();
      process.exit(1);
    }

    const socials = [
      post.fbPostId ? "Facebook" : null,
      post.bskyPostUri ? "Bluesky" : null,
      post.fediPostId ? "Fediversum" : null,
      post.xPostId ? "X" : null,
    ].filter(Boolean);

    console.log("\n============================================================");
    console.log(" Znaleziono post do trwałego usunięcia:");
    console.log(`  ID:            ${post._id}`);
    console.log(`  Tytuł:         ${post.title || "(bez tytułu)"}`);
    console.log(`  Autor:         ${post.author} (${post.authorEmail})`);
    console.log(`  Widoczność:    ${post.visibility}`);
    console.log(`  Grafika:       ${post.imageUrl || "brak"}`);
    console.log(`  Social Media:  ${socials.length > 0 ? socials.join(", ") : "brak"}`);
    console.log(`  Komentarze:    ${post.comments ? post.comments.length : 0}`);
    console.log(`  Polubienia:    ${post.likedBy ? post.likedBy.length : 0}`);
    console.log(
      `  Data dodania:  ${post.createdAt ? post.createdAt.toISOString() : "-"}`
    );
    console.log("============================================================\n");

    const answer = await askConfirmation(
      "Czy na pewno chcesz TRWALE usunąć ten post wraz z grafiką, powiadomieniami i wpisami w social media? [tak/NIE]: "
    );

    if (answer !== "tak") {
      console.log("Anulowano operację.");
      await mongoose.disconnect();
      process.exit(0);
    }

    const mockReq = {
      protocol: "https",
      get: () => process.env.SERVICE_HOST || "poleopinii.pl",
      ip: "127.0.0.1",
    };

    const result = await rmPost(post._id, mockReq);

    if (result.error) {
      console.error(`❌ Błąd: ${result.message}`);
      await mongoose.disconnect();
      process.exit(1);
    }

    console.log(
      `✅ Pomyślnie usunięto post: "${result.deletedPost.title}" (ID: ${result.deletedPost._id})`
    );
    await mongoose.disconnect();
    process.exit(0);
  } catch (err) {
    console.error("❌ Błąd krytyczny:", err);
    try {
      await mongoose.disconnect();
    } catch (_) {}
    process.exit(1);
  }
}

run();
