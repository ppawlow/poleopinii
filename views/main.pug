extends layout

block content
    .main-container
        aside.left-sidebar
            if user
                a.sidebar-item(href="/following-feed" style="text-decoration: none; color: inherit; border-bottom: 1px solid var(--border-color); padding-bottom: 8px; margin-bottom: 8px; display: flex; align-items: center; gap: 12px;")
                    i.fa-solid.fa-rss(style="color: var(--color-primary);")
                    span(style="font-weight: 700; color: var(--text-main); text-transform: uppercase; font-size: 14px; letter-spacing: 0.5px;") Obserwowani autorzy
                    
                if followingProfiles && followingProfiles.length > 0
                    each followed in followingProfiles
                        a.sidebar-item(href=`/profile/${followed._id}` style="text-decoration:none; color:inherit; display:flex; align-items:center; gap:12px;")
                            img.nav-avatar(src=(followed.avatarUrl || DEFAULT_ASSETS.avatar) style="width:28px; height:28px; object-fit: cover;")
                            span(style="font-size: 14px; font-weight: 500;") #{followed.displayName}
                else
                    p(style="font-size: 12px; color: var(--text-muted); padding: 8px 12px; font-style: italic;") Nie obserwujesz jeszcze żadnych autorów.
            else
                a.sidebar-item(href="/search" style="text-decoration: none; color: inherit; margin-bottom: 12px; border-bottom: 2px solid var(--border-color); padding-bottom: 8px; display: flex; align-items: center; gap: 12px;")
                    i.fa-solid.fa-magnifying-glass(style="color: var(--color-primary);")
                    span(style="font-weight: 700; color: var(--text-main); text-transform: uppercase; font-size: 14px; letter-spacing: 0.5px;") Szukaj autorów

                div(style="background: var(--bg-card); padding: 14px; border-radius: 8px; border: 1px solid var(--border-color); margin-bottom: 12px;")
                    form(action="/search" method="GET" style="display: flex; flex-direction: column; gap: 8px; width: 100%;")
                        input.search-bar(type="text" name="q" placeholder="Imię, nazwisko lub pseudonim..." required minlength="3" style="width: 100%; border: 1px solid var(--border-input); border-radius: 6px; padding: 9px 12px; font-size: 13.5px;")
                        button(type="submit" style="background: #1877f2; color: white; border: none; padding: 8px 14px; border-radius: 6px; font-weight: 600; font-size: 13.5px; cursor: pointer; width: 100%;") Szukaj

                #sidebar-search-results.accordion-container(style="display: flex; flex-direction: column; gap: 8px; width: 100%;")

        main.feed
            if user
                if !user.isFullyVerified
                    .verification-reminder-banner.verification-banner-box
                        div(style="flex: 1; padding-right: 16px;")
                            h4(style="margin: 0 0 4px 0; color: var(--alert-info-text); font-size: 15px; font-weight: bold;") 🛡️ Twój profil nie jest jeszcze w pełni aktywny
                            p(style="margin: 0; font-size: 13px; color: var(--text-body); line-height: 1.4;") Aby odblokować wszystkie możliwości profilu, np. zamieszczać artykuły publiczne, brać udział w dyskusjach, kontaktować się prywatnie z innymi użytkownikami, potwierdź swoją autentyczność.
                        a(href="/verify" style="background: #1877f2; color: white; text-decoration: none; padding: 8px 16px; border-radius: 6px; font-weight: bold; font-size: 13px; white-space: nowrap;") Zweryfikuj konto

                if user.isSuspended
                    .admin-alert-box.is-danger(style="margin-bottom: 16px; line-height: 1.5;")
                        | ⛔ <strong>Twoje konto zostało tymczasowo zawieszone</strong> do dnia #{new Date(user.suspendedUntil).toLocaleString('pl-PL')}.
                        if user.suspensionReason
                            br
                            | Powód: <em>#{user.suspensionReason}</em>
                        br
                        small Zgodnie z § 7 pkt 5 Regulaminu interakcje z innymi użytkownikami są zablokowane, a nowe wpisy możesz zapisywać wyłącznie jako prywatne.

                include partials/create-post.pug

            if (SERVICE_SOCIALS && SERVICE_SOCIALS.length > 0) || user
                .feed-toolbar-row(style="display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; margin-bottom: 12px; flex-wrap: wrap;")
                    if SERVICE_SOCIALS && SERVICE_SOCIALS.length > 0
                        .toolbar-group(style="display: flex; flex-direction: column; align-items: flex-start; gap: 6px;")
                            span.toolbar-group-label Obserwuj nas!
                            .service-socials-bar(style="display: flex; align-items: center; gap: 8px;")
                                each soc in SERVICE_SOCIALS
                                    a.social-pill-link(
                                        href=soc.url
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        title=soc.label
                                        aria-label=soc.label
                                        style=`color: ${soc.color};`
                                    )
                                        i(class=soc.icon)
                    else
                        div

                    if user
                        .toolbar-group(style="display: flex; flex-direction: column; align-items: flex-end; gap: 6px; margin-left: auto;")
                            span#feed-view-label.toolbar-group-label= feedView === 'portal' ? 'Widok czytelnika' : 'Widok roboczy'
                            .feed-view-switcher(style="display: flex; align-items: center; gap: 8px;")
                                button.view-switch-btn(type="button" class=(feedView !== 'portal' ? 'active' : '') onclick="window.setFeedViewMode('accordion', event)" title="Widok roboczy" aria-label="Widok roboczy")
                                    i.fa-solid.fa-tools
                                button.view-switch-btn(type="button" class=(feedView === 'portal' ? 'active' : '') onclick="window.setFeedViewMode('portal', event)" title="Widok czytelnika" aria-label="Widok czytelnika")
                                    i.fa-solid.fa-book-open

            #accordion-posts-wrapper.accordion-container
                if posts && posts.length > 0
                    each post in posts
                        if feedView === 'portal'
                            include partials/post-portal-card.pug
                        else
                            include partials/post-card.pug
                else
                    .no-posts.empty-state-box Brak wpisów do wyświetlenia.

            if hasMore
                #load-more-container(style="text-align: center; margin-top: 20px;")
                    button#load-more-btn.action-btn(onclick="loadMorePosts()" style="border: 1px solid var(--border-input); color: #1877f2;") Pokaż więcej

        aside.right-sidebar
            a.sidebar-item(href="/topics" style="text-decoration: none; color: inherit; margin-bottom: 12px; border-bottom: 2px solid var(--border-color); padding-bottom: 8px; display: flex; align-items: center; gap: 12px;")
                i.fa-solid.fa-newspaper(style="color: var(--color-primary);")
                span(style="font-weight: 700; color: var(--text-main); text-transform: uppercase; font-size: 14px; letter-spacing: 0.5px;") Przegląd dnia

            include partials/news-feed.pug
