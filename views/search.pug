extends layout

block content
    .main-container(style="grid-template-columns: 1fr; max-width: 700px; margin: 0 auto;")
        main.feed
            .create-post(style="padding: 24px; margin-bottom: 16px; font-family: sans-serif;")
                form(action="/search" method="GET" style="display: flex; flex-direction: column; gap: 8px; width: 100%;")
                    label(for="search-input-field" style="font-size: 14px; font-weight: 600; color: var(--text-main); display: block;") Wyszukaj autorów platformy:
                    div(style="display: flex; gap: 10px; width: 100%; align-items: center;")
                        input#search-input-field.search-bar(type="text" name="q" placeholder="Wpisz imię, nazwisko lub pseudonim (min. 3 znaki)..." value=query || '' required minlength="3" style="flex: 1; width: 100%; border: 1px solid var(--border-input); border-radius: 6px; padding: 10px 16px; font-size: 15px;")
                        button(type="submit" style="background: #1877f2; color: white; border: none; padding: 10px 20px; border-radius: 6px; font-weight: 600; font-size: 15px; cursor: pointer;") Szukaj
            
            #search-results-holder.accordion-container(style="width: 100%; display: flex; flex-direction: column;")
                if query
                    .create-post(style="padding: 16px; margin-bottom: 12px; box-shadow: none; border: 1px solid var(--border-color);")
                        h3(style="font-size: 16px; margin: 0; color: var(--text-main);") Wyniki wyszukiwania dla: "#{query}"
                
                if results && results.length > 0
                    each resultUser in results
                        .post-card.accordion-item(id=`user-result-${resultUser._id}` style="padding: 0; margin-bottom: 12px; overflow: hidden; width: 100%;")
                            .accordion-header(style="cursor: pointer; padding: 16px; display: flex; align-items: center; justify-content: space-between;")
                                div(style="display: flex; align-items: center; gap: 16px;")
                                    img.profile-main-avatar(src=(resultUser.avatarUrl || DEFAULT_ASSETS.avatar) style="width: 50px; height: 50px; border-radius: 50%; object-fit: cover;")
                                    div
                                        h3(style="font-size: 18px; font-weight: 600; color: var(--text-main); margin: 0;") #{resultUser.displayName || resultUser.name}
                                        span(style="color: var(--text-muted); font-size: 12px;") Kliknij, aby zobaczyć opis...
                                
                                div(style="display: flex; align-items: center; gap: 12px;")
                                    i.fa-solid.fa-chevron-down.accordion-icon(style="color: var(--text-muted); transition: transform 0.3s;")
                            
                            .accordion-content.search-card-body
                                div(style="margin-bottom: 16px;")
                                    h4(style="font-size: 14px; font-weight: 700; color: var(--text-muted); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;") O sobie:
                                    p.search-bio-quote

                                        | #{resultUser.bio || 'Ten użytkownik nie dodał jeszcze żadnych informacji o sobie.'}
                                
                                div(style="display: flex; justify-content: flex-end;")
                                    a.follow-btn(href=(resultUser.alias ? `/profile/${resultUser.alias}` : `/profile/${resultUser._id}`) style="text-decoration: none; display: inline-block; background-color: #1877f2; color: white; padding: 8px 20px; border-radius: 6px; font-weight: 600; font-size: 14px;") Zobacz pełny profil
                else if query
                    .login-prompt.empty-state-box
                        p(style="color: var(--text-muted); font-size: 15px; margin: 0;") Nie znaleziono użytkowników pasujących do kryteriów wyszukiwania.
