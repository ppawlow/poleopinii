extends layout

block append head
    link(rel="stylesheet" href="/css/auth.css?v=1")
    script(src="/js/authApi.js")
    
block content
    .login-container
        .login-branding
            img(src=LOGOTYP width="100%")
            
        .login-box
            h3 Logowanie
            
            if error === '1'
                .admin-alert-box.is-danger(style="margin-bottom: 12px; font-size: 13px;") ⚠️ Niepoprawny adres e-mail lub hasło.
            if error === 'invalid_token'
                .admin-alert-box.is-danger(style="margin-bottom: 12px; font-size: 13px;") ⚠️ Link weryfikacyjny jest nieprawidłowy lub wygasł.
            if msg === 'verified'
                .admin-alert-box.is-success(style="margin-bottom: 12px; font-size: 13px;") 🎉 Konto aktywowane pomyślnie!

            form#loginForm(action="/auth/login" method="POST")
                input(type="hidden" name="_csrf" value=csrfToken)
                input#loginRecaptchaToken(type="hidden" name="recaptchaToken")
                input(type="email" name="email" placeholder="Adres e-mail" required)
                label(style="font-size: 13px; color: var(--text-muted); display: block; margin-bottom: 6px;") Hasło dostępu:
                div(style="position: relative; width: 100%;")
                    input#loginPasswordField(type="password" name="password" placeholder="Hasło" required style="width: 100%; padding-right: 40px;")
                    i.fa-regular.fa-eye#toggleLoginPassword(style="position: absolute; right: 12px; top: 14px; cursor: pointer; color: var(--text-muted);")

                button.login-submit(type="submit") Zaloguj się
                
                div(style="text-align: center; margin-top: 10px;")
                    a(href="/auth/forgot-password" style="text-decoration: none; color: #1877f2; font-size: 13px;") Zapomniałeś hasła?

            hr
            
            div(style="text-align: center; margin-top: 15px;")
                p(style="font-size: 14px; color: var(--text-muted); margin-bottom: 10px;") Nie masz jeszcze konta?
                a.register-submit(href="/auth/register" style="text-decoration: none; display: block; text-align: center; line-height: 24px;") Utwórz nowe konto
