//- views/partials/news-feed.pug
if dailyTopics && dailyTopics.length > 0
    .accordion-container(style="display: flex; flex-direction: column; gap: 10px; width: 100%;")
        each topic in dailyTopics
            - var isCritical = topic.importance >= 8
            .post-card.accordion-item.news-topic-card
                .accordion-header.news-topic-header
                    h3.news-topic-title #{topic.title}
                    i.fa-solid.fa-chevron-down.accordion-icon(style="color: var(--text-muted); font-size: 13px; transition: transform 0.3s; flex-shrink: 0; margin-top: 2px;")
                
                .accordion-content.news-topic-body
                    p.news-topic-summary #{topic.summary}
                    
                    .news-card-footer(style="display: flex; flex-direction: column; gap: 12px; width: 100%; align-items: stretch;")
                        div(style="display: flex; gap: 8px; align-items: center; justify-content: flex-start;")
                            span.news-rank-badge(class=(isCritical ? 'is-critical' : '') title='Ranga informacji')
                                | 🔥 #{topic.importance}/10
                                
                            if user && (user.isAdmin || user.role === 'editor')
                                button.action-btn.btn-danger-soft(type="button" onclick=`window.executeAdminDeleteTopic('${topic._id}', '${topic.title.replace(/'/g, "\\'")}')` style="padding: 0 12px; border-radius: 6px; font-size: 12.5px; height: 32px; margin: 0;")
                                    i.fa-solid.fa-trash-can(style="margin: 0;")

                        div(style="display: flex; flex-direction: column; gap: 8px; width: 100%;")
                            if user
                                button.action-btn.btn-ai-primary(type="button" onclick=`window.initAiTopicDiscussion('${topic.title.replace(/'/g, "\\'")}', '${topic.summary.replace(/'/g, "\\'")}')` style="padding: 10px 16px; border-radius: 6px; font-size: 13px; min-height: 40px; height: auto; line-height: 1.4; width: 100%; margin: 0; text-align: center;")
                                    i.fa-regular.fa-comment-dots(style="flex-shrink: 0;")
                                    span(style="white-space: normal; text-align: center;") Napisz co o tym myślisz?
                        
                                if user.role === 'editor'
                                    button.action-btn.btn-ai-editor(type="button" onclick=`window.generatePressArticleFromTopic('${topic._id}', this)` style="padding: 10px 16px; border-radius: 6px; font-size: 13px; min-height: 40px; height: auto; line-height: 1.4; width: 100%; margin: 0; text-align: center;" title="Wygeneruj rozbudowany artykuł prasowy do prywatnego szkicownika")
                                        i.fa-solid.fa-robot(style="flex-shrink: 0;")
                                        span(style="white-space: normal; text-align: center;") Opracuj temat z AI
else
    .no-posts.empty-state-box
        | ⏳ Trwa pobieranie aktualnych komunikatów. Odśwież stronę za chwilę...
