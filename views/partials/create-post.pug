if user
    .create-post.accordion-item(id="post-new" style="margin-bottom: 16px; padding: 0;")
        .accordion-header(onclick="window.toggleCreatePostAccordion()" style="cursor: pointer; padding: 12px 16px; display: flex; align-items: center; gap: 12px;")
            img.nav-avatar(src=(user.avatarUrl || '/uploads/default-avatar.png') style="width: 36px; height: 36px; border-radius: 50%; object-fit: cover;")
            .search-bar(style="flex: 1; background-color: #f0f2f5; color: #65676b; padding: 10px 16px; border-radius: 50px; font-size: 15px; pointer-events: none;") Stwórz nowy post
            i.fa-solid.fa-chevron-down.create-accordion-icon(style="color: #65676b; transition: transform 0.3s;")
        
        .create-accordion-content(style="display: none; padding: 16px; border-top: 1px solid #e4e6eb;")
            .post-header(style="width: 100%; display: block;")
                .post-author-row(style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;")
                    img.nav-avatar(src=(user.avatarUrl || '/uploads/default-avatar.png'))
                    .author-info
                        h4(style="font-size: 15px; font-weight: 600; margin: 0;") #{user.name}
                        span#create-post-context-time.post-time(style="font-size: 12px; color: #65676b;") Tworzenie nowego wpisu
                
                //- MAPOWANIE NA UNIWERSALNY KONTEKST
                - var activePost = { _id: 'new', title: '', visibility: 'private' }
                include edit.pug
