.post-card.accordion-item(id=`user-result-${resultUser._id}` style="padding: 0; margin-bottom: 12px; overflow: hidden;")
    .accordion-header(style="cursor: pointer; padding: 16px; display: flex; align-items: center; justify-content: space-between;")
        div(style="display: flex; align-items: center; gap: 16px;")
            img.profile-main-avatar(src=(resultUser.avatarUrl || '/uploads/default-avatar.png') style="width: 50px; height: 50px; border-radius: 50%; object-fit: cover;")
            div
                h3(style="font-size: 18px; font-weight: 600; color: #050505; margin: 0;") #{resultUser.name}
                span(style="color: #65676b; font-size: 12px;") Kliknij, aby zobaczyć opis...
        div(style="display: flex; align-items: center; gap: 12px;")
            i.fa-solid.fa-chevron-down.accordion-icon(style="color: #65676b; transition: transform 0.3s;")
    
    .accordion-content(style="display: none; padding: 16px; border-top: 1px solid #e4e6eb; background-color: #fafbfc;")
        div(style="margin-bottom: 16px;")
            h4(style="font-size: 14px; font-weight: 700; color: #65676b; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;") O sobie:
            p(style="font-size: 15px; color: #050505; line-height: 1.5; font-style: italic; background: #fff; padding: 12px; border-radius: 6px; border: 1px solid #e4e6eb;") #{resultUser.bio || 'Ten użytkownik nie dodał jeszcze żadnych informacji o sobie.'}
        div(style="display: flex; justify-content: flex-end;")
            a.follow-btn(href=resultUser.profileUrl style="text-decoration: none; display: inline-block; background-color: #1877f2; color: white; padding: 8px 20px; border-radius: 6px; font-weight: 600; font-size: 14px; transition: background-color 0.2s;") Zobacz pełny profil
