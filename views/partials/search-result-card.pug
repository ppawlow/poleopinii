.post-card.accordion-item(id=`user-result-${resultUser._id}` style="padding: 0; margin-bottom: 12px; overflow: hidden;")
    .accordion-header(style="cursor: pointer; padding: 16px; display: flex; align-items: center; justify-content: space-between;")
        div(style="display: flex; align-items: center; gap: 16px;")
            img.profile-main-avatar(src=(resultUser.avatarUrl || '/uploads/default-avatar.png') style="width: 50px; height: 50px; border-radius: 50%; object-fit: cover;")
            div
                h3(style="font-size: 18px; font-weight: 600; color: var(--text-main); margin: 0;") #{resultUser.name}
                span(style="color: var(--text-muted); font-size: 12px;") Kliknij, aby zobaczyć opis...
        div(style="display: flex; align-items: center; gap: 12px;")
            i.fa-solid.fa-chevron-down.accordion-icon(style="color: var(--text-muted); transition: transform 0.3s;")
    
    .accordion-content.search-card-body
        div(style="margin-bottom: 16px;")
            h4(style="font-size: 14px; font-weight: 700; color: var(--text-muted); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;") O sobie:
            p.search-bio-quote #{resultUser.bio || 'Ten użytkownik nie dodał jeszcze żadnych informacji o sobie.'}
        div(style="display: flex; justify-content: flex-end;")
            a.follow-btn(href=resultUser.profileUrl style="text-decoration: none; display: inline-block; background-color: #1877f2; color: white; padding: 8px 20px; border-radius: 6px; font-weight: 600; font-size: 14px;") Zobacz pełny profil
