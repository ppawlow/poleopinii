- var isAnnouncement = ev.type === 'announcement'

.comment-card.event-row-card(id=`event-row-${ev._id}` class=(isAnnouncement ? 'is-announcement' : ''))
    .event-row-content
        if ev.type === 'announcement'
            i.fa-solid.fa-bullhorn(style="color: var(--alert-success-text); font-size: 18px; width: 24px; text-align: center; flex-shrink: 0;")
            span
                span(style="font-weight: 700; color: var(--alert-success-text); margin-right: 4px;") [Ogłoszenie]
                a(href=ev.senderUrl style="font-weight: 600; color: var(--alert-success-text); text-decoration: none;") #{ev.senderName}
                |  opublikował nowy komunikat: 
                a.event-post-link(href=`/posts/${ev.postId}` style="font-weight: 700;") "#{ev.postTitle}"

        else if ev.type === 'factcheck_warning'
            i.fa-solid.fa-scale-balanced(style="color: var(--alert-danger-text); font-size: 18px; width: 24px; text-align: center; flex-shrink: 0;")
            span
                a(href=ev.senderUrl style="font-weight: 600; color: #1877f2; text-decoration: none;") #{ev.senderName}
                |  zgłosił zastrzeżenia faktograficzne: 
                a(href=`/posts/${ev.postId}` style="font-weight: 600; color: var(--alert-danger-text); text-decoration: underline;") "#{ev.postTitle}"

        else if ev.type === 'like_post'
            i.fa-solid.fa-star(style="color: #E5A93C; font-size: 18px; width: 24px; text-align: center; flex-shrink: 0;")
            span
                a(href=ev.senderUrl style="font-weight: 600; color: #1877f2; text-decoration: none;") #{ev.senderName}
                |  docenił 
                a.event-post-link(href=`/posts/${ev.postId}`) Twój post ("#{ev.postTitle}")
        
        else if ev.type === 'comment_post'
            i.fa-solid.fa-comment(style="color: #42b72a; font-size: 18px; width: 24px; text-align: center; flex-shrink: 0;")
            span
                a(href=ev.senderUrl style="font-weight: 600; color: #1877f2; text-decoration: none;") #{ev.senderName}
                |  skomentował 
                a.event-post-link(href=`/posts/${ev.postId}${ev.commentId ? '#comment-' + ev.commentId : ''}`) Twój post ("#{ev.postTitle}")
        
        else if ev.type === 'reply_comment'
            i.fa-solid.fa-reply(style="color: #9360f7; font-size: 18px; width: 24px; text-align: center; flex-shrink: 0;")
            span
                a(href=ev.senderUrl style="font-weight: 600; color: #1877f2; text-decoration: none;") #{ev.senderName}
                |  odpowiedział na 
                a.event-post-link(href=`/posts/${ev.postId}${ev.commentId ? '#comment-' + ev.commentId : ''}`) Twój komentarz w dyskusji

        else if ev.type === 'reply_post'
            i.fa-regular.fa-comments(style="color: var(--alert-danger-text); font-size: 18px; width: 24px; text-align: center; flex-shrink: 0;")
            span
                a(href=ev.senderUrl style="font-weight: 600; color: #1877f2; text-decoration: none;") #{ev.senderName}
                |  opublikował polemikę: 
                a(href=`/posts/${ev.postId}` style="font-weight: 600; color: var(--alert-danger-text); text-decoration: underline;") "#{ev.postTitle}"
        
        else if ev.type === 'follow'
            i.fa-solid.fa-user-plus(style="color: #1877f2; font-size: 18px; width: 24px; text-align: center; flex-shrink: 0;")
            span
                a(href=ev.senderUrl style="font-weight: 600; color: #1877f2; text-decoration: none;") #{ev.senderName}
                |  zaczął Cię obserwować
    
    span.event-time
        | #{new Date(ev.createdAt).toLocaleDateString('pl-PL')} o #{new Date(ev.createdAt).toLocaleTimeString('pl-PL', {hour: '2-digit', minute:'2-digit'})}
