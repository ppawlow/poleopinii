if logs && logs.length > 0
    div(style="overflow-x: auto; background: #ffffff; border: 1px solid #e4e6eb; border-radius: 8px; box-shadow: 0 1px 2px rgba(0,0,0,0.02);")
        table#logsTable(style="width: 100%; border-collapse: collapse; font-size: 13.5px; text-align: left; font-family: sans-serif;")
            thead
                tr(style="background: #f0f2f5; border-bottom: 2px solid #e4e6eb; color: #4a5568;")
                    th(style="padding: 12px 16px; font-weight: 700;") Data i godzina
                    th(style="padding: 12px 16px; font-weight: 700;") Podmiot / Użytkownik
                    th(style="padding: 12px 16px; font-weight: 700;") Zarejestrowane Działanie
            tbody
                each log in logs
                    - var isAiLog = log.action && log.action.includes('[AI')
                    tr(style=`border-bottom: 1px solid #e4e6eb; background: ${isAiLog ? '#f7faff' : '#ffffff'}; transition: background 0.15s;`)
                        td(style="padding: 12px 16px; color: #65676b; white-space: nowrap;") 
                            | #{new Date(log.createdAt).toLocaleString('pl-PL')}
                        td(style=`padding: 12px 16px; font-weight: 600; color: ${isAiLog ? '#1877f2' : '#1c1e21'};`) 
                            | #{log.userDisplayName}
                        td(style=`padding: 12px 16px; line-height: 1.4; color: ${log.action.includes('[BŁĄD]') || log.action.includes('[ODRZUCONO]') ? '#bc2525' : '#050505'};`) 
                            | #{log.action}
else
    .no-posts(style="text-align: center; padding: 32px; color: #65676b; background: #f0f2f5; border-radius: 6px;") W systemie nie odnotowano jeszcze żadnych logów zdarzeń.
