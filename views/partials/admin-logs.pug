.admin-form-box(style="margin-bottom: 20px; padding: 16px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; font-family: sans-serif;")
    div
        label(for="log-date-picker" style="font-size: 13.5px; font-weight: 700; color: var(--text-main); display: block; margin-bottom: 4px;") 📅 Filtruj historię audytu archiwalnego:
        span(style="font-size: 12px; color: var(--text-muted);") Domyślnie wyświetlane są logi z ostatnich 24 godzin (maksymalna retencja wynosi 30 dni).
    div
        - var today = new Date().toISOString().split('T')[0]
        - var thirtyDaysAgo = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0]
        input#log-date-picker(type="date" value=today name="filterDate" min=thirtyDaysAgo max=today style="padding: 8px 12px; border: 1px solid var(--border-input); border-radius: 6px; font-size: 14px; font-weight: 600; outline: none; cursor: pointer;")

.admin-table-wrapper
    table#logsTable.admin-table(style="font-size: 13.5px;")
        thead
            tr
                th(style="padding: 12px 16px; font-weight: 700;") Data i godzina
                th(style="padding: 12px 16px; font-weight: 700;") Podmiot / Użytkownik
                th(style="padding: 12px 16px; font-weight: 700;") Adres IP
                th(style="padding: 12px 16px; font-weight: 700;") Zarejestrowane Działanie
        tbody#logs-table-body
            include admin-logs-rows.pug
