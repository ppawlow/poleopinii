div(style="margin-bottom: 20px; background: #f0f2f5; padding: 16px; border-radius: 6px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; font-family: sans-serif;")
    div
        label(for="log-date-picker" style="font-size: 13.5px; font-weight: 700; color: #4a5568; display: block; margin-bottom: 4px;") 📅 Filtruj historię audytu archiwalnego:
        span(style="font-size: 12px; color: #65676b;") Domyślnie wyświetlane są logi z ostatnich 24 godzin (maksymalna retencja wynosi 30 dni).
    div
        - var today = new Date().toISOString().split('T')[0]
        - var thirtyDaysAgo = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000).toISOString().split('T')[0]
        input#log-date-picker(type="date" name="filterDate" min=thirtyDaysAgo max=today style="padding: 8px 12px; border: 1px solid #dddfe2; border-radius: 6px; font-size: 14px; font-weight: 600; outline: none; background: #fff; cursor: pointer;")

div(style="overflow-x: auto; background: #ffffff; border: 1px solid #e4e6eb; border-radius: 8px; box-shadow: 0 1px 2px rgba(0,0,0,0.02);")
    table#logsTable(style="width: 100%; border-collapse: collapse; font-size: 13.5px; text-align: left; font-family: sans-serif;")
        thead
            tr(style="background: #f0f2f5; border-bottom: 2px solid #e4e6eb; color: #4a5568;")
                th(style="padding: 12px 16px; font-weight: 700;") Data i godzina
                th(style="padding: 12px 16px; font-weight: 700;") Podmiot / Użytkownik
                th(style="padding: 12px 16px; font-weight: 700;") Adres IP
                th(style="padding: 12px 16px; font-weight: 700;") Zarejestrowane Działanie
        tbody#logs-table-body
            include admin-logs-rows.pug
