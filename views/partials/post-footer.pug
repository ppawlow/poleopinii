//- Sekcja statystyk
.post-stats(style="margin-top: 12px; margin-bottom: 8px; display: flex; justify-content: space-between; color: #65676b; font-size: 13.5px; font-family: sans-serif;")
    span
        i.fa-solid.fa-star(style="color: #E5A93C; margin-right: 4px;") 
        span.likes-count(id=`likes-text-${post._id}`)= `${post.likesCount || 0} polubień`
        
    span.comments-count(onclick=`toggleCommentsVisibility('${post._id}')` style="cursor: pointer; user-select: none; font-weight: 500; color: #1877f2;") 
        i.fa-solid.fa-comment(style="color: #42b72a; margin-right: 4px;") 
        span.comments-total-count(id=`comments-text-${post._id}`)= `${post.comments ? post.comments.length : 0} komentarzy`
        
.post-actions(style="display: flex; padding: 4px 0; border-bottom: 1px solid #e4e6eb; gap: 8px; flex-wrap: wrap;")
    if user
        if hasPermission(user, post.visibility, 'LIKE') && (!userBlocks || !userBlocks.includes(String(post.authorId))) && String(user.id) !== String(post.authorId)
            form.post-like-form(action=`/posts/${post._id}/like` method="POST" data-post-id=post._id style="margin: 0; display: inline-block;")
                input(type="hidden" name="_csrf" value=csrfToken)
                button.action-btn(type="submit" title="Zarządzaj oceną wpisu")
                    if post.isLikedByMe
                        i.fa-solid.fa-star
                        span.btn-text.like-text Cofnij
                    else
                        i.fa-regular.fa-star
                        span.btn-text.like-text Doceń
        else if String(user.id) !== String(post.authorId)
            button.action-btn.restricted-feature-trigger(type="button" data-reason="like_public" title="Kliknij, aby dowiedzieć się więcej")
                i.fa-regular.fa-star
                span.btn-text Doceń
                
        button.action-btn.comment-trigger-btn(type="button" onclick=`toggleCommentsVisibility('${post._id}')` title="Napisz komentarz")
            i.fa-regular.fa-comment
            span.btn-text Skomentuj

        if !post.isAbuseReport && String(user.id) !== String(post.authorId)
            button.action-btn.reply-post-btn(type="button" onclick=`window.openReplyPostModal('${post._id}', '${post.title ? post.title.replace(/'/g, "\\'") : "Wpis"}')` title="Polemizuj")
                i.fa-regular.fa-comments
                span.btn-text Polemizuj
    else
        button.action-btn(disabled)
          i.fa-regular.fa-star
          span.btn-text Doceń
    if post.visibility === 'public'
        button.action-btn.share-btn(type="button" onclick=`window.sharePost('${post._id}', '${post.title ? post.title.replace(/'/g, "\\'") : "Wpis"}')` title="Udostępnij")
            i.fa-regular.fa-share-from-square
            span.btn-text Udostępnij

    if post.visibility === 'public' && (!user || String(user.id) !== String(post.authorId))
        button.action-btn.abuse-trigger-btn(type="button" onclick=`triggerAbuseReport('${post._id}', '${post.title ? post.title.replace(/'/g, "\\'") : "Wpis"}')` title="Zgłoś nadużycie" style="background: #fff3f3; color: #bc2525;")
            i.fa-solid.fa-triangle-exclamation
            span.btn-text Zgłoś nadużycie

//- Sekcja komentarzy
div(id=`comments-wrapper-${post._id}` style="display: none; width: 100%; margin-top: 16px;")
    .article-comments-block(style="border-top: 1px solid #e4e6eb; padding-top: 16px; font-family: sans-serif;")
        h3(id=`discussion-heading-${post._id}` style="font-size: 16px; font-weight: 700; margin-bottom: 16px; color: #1c1e21;") 
            | Dyskusja (#{post.comments ? post.comments.length : 0})
        include post-comments.pug

script.
    (() => {
        const polubienia = (num) => liczebnik(num, ["polubienie", "polubienia", "polubień"]);
        const komentarze = (num) => liczebnik(num, ["komentarz", "komentarze", "komentarzy"]);

        const likesEl = document.getElementById("likes-text-#{post._id}");
        const commentsEl = document.getElementById("comments-text-#{post._id}");

        if (likesEl) likesEl.innerHTML = polubienia(parseInt("#{post.likesCount || 0}") || 0);
        if (commentsEl) commentsEl.innerHTML = komentarze(parseInt("#{post.comments ? post.comments.length : 0}") || 0);
    })();
