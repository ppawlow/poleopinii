//- Sekcja statystyk
.post-stats(style="margin-top: 12px; margin-bottom: 8px; display: flex; justify-content: space-between; color: var(--text-muted); font-size: 13.5px; font-family: sans-serif;")
    span
        i.fa-solid.fa-star(style="color: #E5A93C; margin-right: 4px;") 
        span.likes-count(id=`likes-text-${post._id}` data-count=(post.likesCount || 0))= `${post.likesCount || 0} polubień`
        
    span.comments-count(onclick=`toggleCommentsVisibility('${post._id}')` style="cursor: pointer; user-select: none; font-weight: 500; color: #1877f2;") 
        i.fa-solid.fa-comment(style="color: #42b72a; margin-right: 4px;") 
        span.comments-total-count(id=`comments-text-${post._id}` data-count=(post.comments ? post.comments.length : 0))= `${post.comments ? post.comments.length : 0} komentarzy`
        
.post-actions(style="display: flex; padding: 4px 0; gap: 8px; flex-wrap: wrap;")
    //- 1. DOCEŃ
    if user
        if hasPermission(user, post.visibility, 'LIKE') && (!userBlocks || !userBlocks.includes(String(post.authorId))) && !user.isOwnerOf(post)
            form.post-like-form(action=`/posts/${post._id}/like` method="POST")
                input(type="hidden" name="_csrf" value=csrfToken)
                button.action-btn(type="submit" title=(post.isLikedByMe ? "Cofnij polubienie" : "Doceń wpis"))
                    i(class=(post.isLikedByMe ? "fa-solid fa-star" : "fa-regular fa-star"))
                    span.btn-text.like-text #{post.isLikedByMe ? 'Cofnij' : 'Doceń'}
        else if !user.isOwnerOf(post)
            button.action-btn.restricted-feature-trigger(type="button" data-reason="like_public" title="Wymaga weryfikacji profilu")
                i.fa-regular.fa-star
                span.btn-text Doceń
    else
        button.action-btn.restricted-feature-trigger(type="button" data-reason="guest_like" title="Zaloguj się, aby docenić wpis")
            i.fa-regular.fa-star
            span.btn-text Doceń

    //- 2. KOMENTUJ
    if user
        button.action-btn.comment-trigger-btn(type="button" onclick=`toggleCommentsVisibility('${post._id}')` title="Napisz komentarz")
            i.fa-regular.fa-comment
            span.btn-text Skomentuj

    //- 3. POLEMIZUJ / KONTYNUUJ WĄTEK
    if user && !post.isAbuseReport && !post.isFactCheckReport
        - var isOwnPost = String(user.id) === String(post.authorId)
        if post.visibility !== 'users' || isOwnPost
            button.action-btn.reply-post-btn(
                type="button" 
                onclick=`window.openReplyPostModal('${post._id}', '${post.title ? post.title.replace(/'/g, "\\'") : "Wpis"}', ${isOwnPost})` 
                title=(isOwnPost ? "Kontynuuj wątek w nowym wpisie" : "Polemizuj")
            )
                i(class=(isOwnPost ? "fa-solid fa-code-branch" : "fa-regular fa-comments"))
                span.btn-text #{isOwnPost ? 'Kontynuuj wątek' : 'Polemizuj'}

    //- 4. UDOSTĘPNIJ
    if post.visibility === 'public'
        button.action-btn.share-btn(type="button" onclick=`window.sharePost('${post._id}', '${post.title ? post.title.replace(/'/g, "\\'") : "Wpis"}')` title="Udostępnij")
            i.fa-solid.fa-share-nodes
            span.btn-text Udostępnij

    //- 5. PRAWDA? (Weryfikacja faktograficzna AI)
    if user && post.visibility === 'public' && !post.isAbuseReport && !post.isFactCheckReport && !post.hasAiReport
        button.action-btn.factcheck-reader-trigger-btn(
            type="button" 
            id=`factcheck-btn-${post._id}`
            onclick=`window.executeReaderFactCheckWithConfirm('${post._id}', this)` 
            title="Zweryfikuj wiarygodność i fakty zawarte we wpisie" 
            style="background: var(--alert-success-bg); color: var(--alert-success-text); border: 1px solid var(--alert-success-border);"
        )
            i.fa-solid.fa-scale-balanced
            span.btn-text Prawda?

    //- 6. ZGŁOŚ NADUŻYCIE
    if post.visibility === 'public' && (!user || String(user.id) !== String(post.authorId))
        button.action-btn.abuse-trigger-btn(
            type="button" 
            onclick=`triggerAbuseReport('${post._id}', '${post.title ? post.title.replace(/'/g, "\\'") : "Wpis"}')` 
            title="Zgłoś nadużycie" 
            style="background: var(--alert-danger-bg); color: var(--alert-danger-text); border: 1px solid var(--alert-danger-border);"
        )
            i.fa-solid.fa-triangle-exclamation
            span.btn-text Zgłoś nadużycie

//- Sekcja komentarzy
div(id=`comments-wrapper-${post._id}` style="display: none; width: 100%; margin-top: 16px;")
    .article-comments-block(style="border-top: 1px solid var(--border-color); padding-top: 16px; font-family: sans-serif;")
        h3(id=`discussion-heading-${post._id}` style="font-size: 16px; font-weight: 700; margin-bottom: 16px; color: var(--text-main);") 
            | Dyskusja (#{post.comments ? post.comments.length : 0})
        include post-comments.pug
