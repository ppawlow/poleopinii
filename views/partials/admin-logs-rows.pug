if logs && logs.length > 0
    each log in logs
        - var isAiLog = log.action && log.action.includes('[AI')
        tr(style=`border-bottom: 1px solid #e4e6eb; background: ${isAiLog ? '#f7faff' : '#ffffff'}; transition: background 0.15s;`)
            td(style="padding: 12px 16px; color: #65676b; white-space: nowrap;") 
                | #{new Date(log.createdAt).toLocaleString('pl-PL')}
            td(style=`padding: 12px 16px; font-weight: 600; color: ${isAiLog ? '#1877f2' : '#1c1e21'}; white-space: nowrap;`)
                if log.userId
                    a(href=`/profile/${log.userId._id}` style="color: #1877f2; text-decoration: none; transition: text-decoration 0.2s;") #{log.userDisplayName}
                else
                    | #{log.userDisplayName}
            td(style="padding: 12px 16px; font-family: monospace; color: #4a5568; white-space: nowrap;")
                | #{log.ipAddress}
            td(style=`padding: 12px 16px; line-height: 1.4; color: ${log.action.includes('[BŁĄD]') || log.action.includes('[ODRZUCONO]') ? '#bc2525' : '#050505'};`) 
                | #{log.action}
else
    tr
        td(colspan="4" style="text-align: center; padding: 24px; color: #65676b; background: #fafbfc;") Brak wpisów w logach dla wybranego zakresu czasowego.
