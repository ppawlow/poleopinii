if logs && logs.length > 0
    each log in logs
        - var isAiLog = log.action && log.action.includes('[AI')
        - var isErrorLog = log.action && (log.action.includes('[BŁĄD]') || log.action.includes('[ODRZUCONO]'))
        tr(class=(isAiLog ? 'is-ai-row' : ''))
            td(style="padding: 12px 16px; color: var(--text-muted); white-space: nowrap;") 
                | #{new Date(log.createdAt).toLocaleString('pl-PL')}
            td(style=`padding: 12px 16px; font-weight: 600; color: ${isAiLog ? '#1877f2' : 'var(--text-main)'}; white-space: nowrap;`)
                if log.userId
                    a(href=`/profile/${log.userId._id}` style="color: #1877f2; text-decoration: none;") #{log.userDisplayName}
                else
                    | #{log.userDisplayName}
            td(style="padding: 12px 16px; font-family: monospace; color: var(--text-muted); white-space: nowrap;")
                | #{log.ipAddress}
            td.admin-log-action(class=(isErrorLog ? 'is-error' : '') style="padding: 12px 16px;")
                | #{log.action}
else
    tr
        td(colspan="4" style="text-align: center; padding: 24px; color: var(--text-muted);") Brak wpisów w logach dla wybranego zakresu czasowego.
