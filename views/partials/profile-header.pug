//- views/partials/profile-header.pug
.profile-header-card
    .cover-photo-wrapper
        img.cover-photo(src=profileUser.coverUrl alt="Cover photo")
    .profile-avatar-row
        .avatar-wrapper
            img.profile-main-avatar(src=profileUser.avatarUrl alt="Avatar")
        .profile-user-details
            h2(style="display: inline-flex; align-items: center; gap: 8px; margin: 0;") 
                | #{profileUser.displayName}

            div(style="margin-top: 8px; display: flex; gap: 8px; flex-wrap: wrap; align-items: center;")
                if currentRank
                    div.profile-rank-badge(style=`display: inline-flex; align-items: center; background: ${currentRank.bg}; color: ${currentRank.color}; padding: 4px 12px; border-radius: 20px; font-size: 13px; font-weight: 700; border: 1px solid ${currentRank.color};` title=`Próg punktowy poziomu wynosi: ${currentRank.minLikes} lajków`)
                        span #{currentRank.name}
                        
                    if profileUser.isFullyVerified
                        span(title="Profil Zweryfikowany" style="color: #1877f2; font-size: 20px; display: inline-flex;") 
                            i.fa-solid.fa-circle-check
                    else
                        span(title="Profil Niezweryfikowany" style="color: #8a8d91; font-size: 20px; display: inline-flex;") 
                            i.fa-solid.fa-circle-xmark

        if user && String(user.id) === String(profileUser._id)
            //- Ujednolicony kontener z nową klasą profilu mobilnego
            div.update-photos-container.profile-actions-mobile(style="display: flex; gap: 8px; margin-bottom: 16px; margin-left: auto; flex-wrap: nowrap; align-items: center;")
                
                form.update-photos-form(action="/profile/update-photos" method="POST" enctype="multipart/form-data" style="margin: 0; display: inline-flex;")
                    label.upload-action-btn(for="avatar-file-input" title="Zmień awatar" style="margin: 0; display: inline-flex; align-items: center; gap: 6px; white-space: nowrap;")
                        i.fa-solid.fa-camera
                        span.btn-text  Zmień awatar
                    input#avatar-file-input(type="file" name="avatar" accept="image/*" style="display: none;" onchange="uploadProfilePhoto(this)")

                form.update-photos-form(action="/profile/update-photos" method="POST" enctype="multipart/form-data" style="margin: 0; display: inline-flex;")
                    label.upload-action-btn(for="cover-file-input" title="Zmień tło" style="margin: 0; display: inline-flex; align-items: center; gap: 6px; white-space: nowrap;")
                        i.fa-solid.fa-image
                        span.btn-text  Zmień tło
                    input#cover-file-input(type="file" name="cover" accept="image/*" style="display: none;" onchange="uploadProfilePhoto(this)")
        
                button.upload-action-btn(type="button" title="Ustawienia" onclick="location=`/profile/settings`" style="margin: 0; display: inline-flex; align-items: center; gap: 6px; border: none; white-space: nowrap;")
                    i.fa-solid.fa-gear
                    span.btn-text  Ustawienia

        else if user
            div.profile-guest-actions-mobile(style="display: flex; gap: 8px; margin-bottom: 16px; margin-left: auto; flex-wrap: nowrap; align-items: center;")
                form.dynamic-follow-form(action=`/follow/${profileUser._id}` method="POST" data-target-id=profileUser._id style="margin:0; display: inline-flex;")
                    input(type="hidden" name="_csrf" value=csrfToken)
                    button.profile-follow-btn(
                        type="submit" 
                        title="Obserwuj / Przestań obserwować" 
                        class=(followingList.includes(String(profileUser._id)) ? 'is-following' : '')
                    )
                        if followingList.includes(String(profileUser._id))
                            i.fa-solid.fa-user-check
                        else
                            i.fa-solid.fa-user-plus
                        span.btn-text #{followingList.includes(String(profileUser._id)) ? 'Obserwujesz' : 'Obserwuj'}

                form.dynamic-block-form(action=`/block/${profileUser._id}` method="POST" data-target-id=profileUser._id style="margin:0; display: inline-flex;")
                    input(type="hidden" name="_csrf" value=csrfToken)
                    button.profile-block-main-btn(
                        type="submit" 
                        title="Zablokuj / Odblokuj użytkownika"
                        class=(userBlocks.includes(String(profileUser._id)) ? 'is-blocking' : '')
                    )
                        if userBlocks.includes(String(profileUser._id))
                            i.fa-solid.fa-shield-halved
                        else
                            i.fa-solid.fa-hand
                        span.btn-text #{userBlocks.includes(String(profileUser._id)) ? 'Odblokuj' : 'Zablokuj'}
                        
                if profileUser.allowPrivateEmails
                    if hasPermission(user, 'user', 'canSendMail', profileUser)
                        button.profile-mail-main-btn(type="button" title="Wyślij prywatną wiadomość" onclick=`openContactMailModal('${profileUser._id}', '${profileUser.nickname || profileUser.name}')`) 
                            i.fa-solid.fa-envelope
                            span.btn-text Wyślij wiadomość
                    else if !user.isFullyVerified
                        button.restricted-feature-trigger(type="button" title="Wymaga weryfikacji profilu" data-reason="private_mail_unverified") 
                            i.fa-solid.fa-envelope
                            span.btn-text Wyślij wiadomość
