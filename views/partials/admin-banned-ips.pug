if bannedIps && bannedIps.length > 0
    .admin-table-wrapper
        table#bannedIpsTable.admin-table(style="font-size: 13px;")
            thead
                tr
                    th(style="padding: 12px; font-weight: 700;") Adres IP
                    th(style="padding: 12px; font-weight: 700;") Powód blokady
                    th(style="padding: 12px; font-weight: 700;") Wykryte ścieżki
                    th(style="padding: 12px; font-weight: 700; text-align: center;") Wygasa za
                    th(style="padding: 12px; font-weight: 700; text-align: center;") Akcja
            tbody#banned-ips-table-body
                each item in bannedIps
                    - var expiresMs = new Date(item.createdAt).getTime() + 60 * 60 * 1000
                    - var minsLeft = Math.max(1, Math.ceil((expiresMs - Date.now()) / 60000))
                    tr(id=`banned-ip-row-${item._id}`)
                        td(style="padding: 12px; font-family: monospace; font-weight: 700; color: var(--alert-danger-text); white-space: nowrap;")
                            | #{item.ip}
                        td(style="padding: 12px; color: var(--text-main);")
                            | #{item.reason}
                        td(style="padding: 12px; font-family: monospace; font-size: 12px; color: var(--text-muted); max-width: 260px; word-break: break-all;")
                            | #{Array.isArray(item.lastPaths) && item.lastPaths.length ? item.lastPaths.join(', ') : '-'}
                        td(style="padding: 12px; text-align: center; white-space: nowrap;")
                            span.admin-pill.is-warning #{minsLeft} min
                        td(style="padding: 12px; text-align: center; white-space: nowrap;")
                            button(
                                type="button"
                                onclick=`executeUnbanIp('${item._id}', '${item.ip}', this)`
                                style="background: #146c43; color: white; border: none; padding: 6px 12px; border-radius: 6px; font-weight: 700; cursor: pointer; font-size: 12px;"
                            ) 🔓 Odblokuj
else
    .no-posts.empty-state-box Aktualnie brak zbanowanych adresów IP w systemie.
