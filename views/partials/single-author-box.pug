.article-bottom-sections(style="padding: 0 24px;")
    section.article-author-box(style="margin-top: 40px; padding: 24px; background: var(--bg-muted); border: 1px solid var(--border-color); border-radius: 8px; display: flex; gap: 16px; align-items: center;")
        a(href=getProfileUrl(post.authorDetails))
            img(src=(post.authorDetails ? post.authorDetails.avatarUrl : DEFAULT_ASSETS.avatar) style="width: 64px; height: 64px; border-radius: 50%; object-fit: cover; box-shadow: 0 2px 5px rgba(0,0,0,0.1);")
        div(style="flex: 1;")
            h4(style="margin: 0 0 4px 0; font-size: 16px; font-weight: 700; color: var(--text-main);") 
                | O autorze: #{post.authorDetails ? post.authorDetails.name : post.author}
            p(style="margin: 0; font-size: 14px; color: var(--text-muted); font-style: italic; font-family: sans-serif; line-height: 1.4;") #{authorBio}
