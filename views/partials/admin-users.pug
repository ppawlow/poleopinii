if systemUsers && systemUsers.length > 0
    .admin-table-wrapper
        table#usersTable.admin-table(style="font-size: 13px;")
            thead
                tr
                    th(style="padding: 12px; font-weight: 700;") Użytkownik / E-mail
                    th(style="padding: 12px; font-weight: 700; text-align: center;") Rola / Status
                    th(style="padding: 12px; font-weight: 700; text-align: center;") Posty (Pub / Zas / Pryw)
                    th(style="padding: 12px; font-weight: 700; text-align: center;") Gwiazdki
                    th(style="padding: 12px; font-weight: 700; text-align: center; color: var(--alert-danger-text);") Redaktor Serwisu
                    th(style="padding: 12px; font-weight: 700; text-align: center;") Zawieszenie
            tbody
                each sUser in systemUsers
                    tr
                        td(style="padding: 12px;")
                            a(href=getProfileUrl({ _id: sUser._id, alias: sUser.alias || null }) style="font-weight: 600; color: #1877f2; text-decoration: none;") #{sUser.name}
                            div(style="font-size: 11px; color: var(--text-muted); margin-top: 2px;") #{sUser.email}
                        
                        td(style="padding: 12px; text-align: center;")
                            if sUser.role === 'editor'
                                span.admin-pill.is-info(style="color: #9360f7; border-color: #9360f7; border-radius: 4px;") 🌟 Redaktor (Zatwierdzony)
                            else if sUser.totalStars >= 100
                                span.admin-pill.is-info(style="color: #a855f7; border-color: #a855f7; border-radius: 4px;") ⏳ Kandydat (Głosowanie)
                            else
                                span(style="color: var(--text-muted); font-size: 12px;") Standardowy Autor
                        
                        td(style="padding: 12px; text-align: center; font-weight: 500;")
                            span(style="color: var(--alert-success-text);" title="Publiczne") #{sUser.publicCount}
                            |  / 
                            span(style="color: #1877f2;" title="Zastrzeżone") #{sUser.restrictedCount}
                            |  / 
                            span(style="color: var(--text-muted);" title="Prywatne") #{sUser.privateCount}
                        
                        td(style="padding: 12px; text-align: center; font-weight: bold; color: #e5a93c;")
                            | ⭐ #{sUser.totalStars}

                        td(style="padding: 12px; text-align: center;")
                            .block-toggle-container(style="display: inline-block; vertical-align: middle;" title=(sUser.role === 'editor' ? "Odbierz uprawnienia Redaktora" : "Mianuj użytkownika Redaktorem"))
                                label.switch
                                    input(
                                        type="checkbox" 
                                        checked=(sUser.role === 'editor') 
                                        onclick=`toggleEditorSlider(this, '${sUser._id}')`
                                    )
                                    span.slider
                        - var isUserSuspended = sUser.suspendedUntil && new Date(sUser.suspendedUntil).getTime() > Date.now()
                        td(id=`suspend-cell-${sUser._id}` style="padding: 12px; text-align: center;")
                            if isUserSuspended
                                div(style="font-size: 11px; color: var(--alert-danger-text); font-weight: 700; margin-bottom: 4px;")
                                    | ⛔ Do: #{new Date(sUser.suspendedUntil).toLocaleDateString('pl-PL')}
                                button(
                                    type="button"
                                    onclick=`executeUnsuspendUser('${sUser._id}')`
                                    style="background: #146c43; color: white; border: none; padding: 4px 10px; border-radius: 4px; font-size: 11px; font-weight: 600; cursor: pointer;"
                                ) Odblokuj
                            else
                                button(
                                    type="button"
                                    onclick=`openSuspendUserModal('${sUser._id}', '${sUser.name.replace(/'/g, "\\'")}')`
                                    style="background: #bc2525; color: white; border: none; padding: 4px 10px; border-radius: 4px; font-size: 11px; font-weight: 600; cursor: pointer;"
                                ) Zawieś

else
    .no-posts.empty-state-box W systemie nie odnotowano zarejestrowanych kont użytkowników.
