if systemUsers && systemUsers.length > 0
    div(style="overflow-x: auto; background: #ffffff; border: 1px solid #e4e6eb; border-radius: 8px; box-shadow: 0 1px 2px rgba(0,0,0,0.02);")
        table#usersTable(style="width: 100%; border-collapse: collapse; font-size: 13px; text-align: left; font-family: sans-serif;")
            thead
                tr(style="background: #f0f2f5; border-bottom: 2px solid #e4e6eb; color: #4a5568;")
                    th(style="padding: 12px; font-weight: 700;") Użytkownik / E-mail
                    th(style="padding: 12px; font-weight: 700; text-align: center;") Posty (Pub / Zas / Pryw)
                    th(style="padding: 12px; font-weight: 700; text-align: center;") Gwiazdki
                    th(style="padding: 12px; font-weight: 700; text-align: center; color: #bc2525;") Blokady AI (Treść / Fakty)
            tbody
                each sUser in systemUsers
                    - var hasSafetyViolations = sUser.aiBlockedSafetyCount > 0
                    - var hasFactCheckViolations = sUser.aiBlockedFactCheckCount > 0
                    tr(style="border-bottom: 1px solid #e4e6eb; transition: background 0.15s;")
                        td(style="padding: 12px;")
                            div(style="font-weight: 600; color: #1c1e21;") #{sUser.name}
                            div(style="font-size: 11px; color: #65676b; margin-top: 2px;") #{sUser.email}
                        
                        td(style="padding: 12px; text-align: center; font-weight: 500;")
                            span(style="color: #146c43;" title="Publiczne") #{sUser.publicCount}
                            |  / 
                            span(style="color: #1877f2;" title="Zastrzeżone") #{sUser.restrictedCount}
                            |  / 
                            span(style="color: #65676b;" title="Prywatne") #{sUser.privateCount}
                        
                        td(style="padding: 12px; text-align: center; font-weight: bold; color: #e5a93c;")
                            | ⭐ #{sUser.totalStars}
                        
                        td(style="padding: 12px; text-align: center;")
                            span(style=`display: inline-block; padding: 2px 6px; border-radius: 4px; font-weight: bold; font-size: 11px; ${hasSafetyViolations ? 'background: #fff3f3; color: #bc2525; border: 1px solid #f5c6cb;' : 'color: #bcc0c4;'}` title="Zablokowane treści zabronione/wulgaryzmy")
                                | 🚫 #{sUser.aiBlockedSafetyCount}
                            |  
                            span(style=`display: inline-block; padding: 2px 6px; border-radius: 4px; font-weight: bold; font-size: 11px; ${hasFactCheckViolations ? 'background: #fff3f3; color: #bc2525; border: 1px solid #f5c6cb;' : 'color: #bcc0c4;'}` title="Zablokowane kłamstwa/błędy faktograficzne")
                                | 📝 #{sUser.aiBlockedFactCheckCount}
else
    .no-posts(style="text-align: center; padding: 32px; color: #65676b; background: #f0f2f5; border-radius: 6px;") W systemie nie odnotowano zarejestrowanych kont użytkowników.
