if abuseReports && abuseReports.length > 0
    section.abuse-reports-box(style="margin-top: 24px; padding: 16px; background: var(--alert-danger-bg); border: 1px solid var(--alert-danger-border); border-radius: 8px; font-family: sans-serif;")
        div(onclick="toggleAbuseReportsVisibility()" style="cursor: pointer; user-select: none; display: flex; justify-content: space-between; align-items: center;")
            h3(style="font-size: 16px; font-weight: 700; color: var(--alert-danger-text); margin: 0; display: inline-flex; align-items: center; gap: 8px;") 
                i.fa-solid.fa-triangle-exclamation
                | Zgłoszenia nadużyć powiązane z wpisem (#{abuseReports.length})
            i.fa-solid.fa-chevron-down#abuse-accordion-icon(style="color: var(--alert-danger-text); transition: transform 0.3s;")
        
        #abuse-reports-wrapper(style="display: none; margin-top: 16px; border-top: 1px dashed var(--alert-danger-border); padding-top: 12px;")
            ul(style="list-style: none; padding-left: 0; margin: 0; display: flex; flex-direction: column; gap: 12px;")
                each report in abuseReports
                    li(style="font-size: 14px; border-bottom: 1px solid var(--alert-danger-border); padding-bottom: 8px;")
                        div(style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;")
                            b(style="color: var(--text-main);") Autor zgłoszenia: #{report.author} 
                            span(style="color: var(--text-muted); font-size: 12px;") #{new Date(report.createdAt).toLocaleDateString('pl-PL')}
                        div(style="color: var(--alert-danger-text); font-style: italic; background: var(--bg-card); padding: 10px; border-radius: 6px; border-left: 3px solid var(--alert-danger-text);")!= report.content
