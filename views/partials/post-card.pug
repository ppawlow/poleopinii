- var isEditorPost = post.visibility === 'editors'
- var isSingleView = false
- var isWorkMode = true

article.post-card.portal-news-card.accordion-item(
    id=`post-${post._id}` 
    style=isEditorPost ? "background-color: #fffdf0; border-left: 4px solid #e5a93c;" : undefined
)
    .accordion-header(style="cursor: pointer; padding: 0 0 16px 0;")
        include post-header-portal.pug

    .accordion-content(style=isEditorPost ? "display: none; padding: 0; border-top: 1px solid #dddfe2; background-color: #fffdf5; width: 100%;" : "display: none; padding: 0; border-top: 1px solid #e4e6eb; width: 100%;")
        if post.imageUrl
            .portal-card-image-link(style="cursor: zoom-in;" onclick=`window.openLightbox('${post.imageUrl}')`)
                img.portal-card-image(src=post.imageUrl alt=(post.title || 'Zdjęcie wyróżniające') loading="lazy")

        div(style="padding: 16px 20px;")
            .post-view-mode(id=`view-${post._id}`)
                include post-body.pug

            include post-footer.pug
