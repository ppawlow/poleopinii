.info-box(style="padding: 16px; border: 1px solid var(--border-color); font-family: sans-serif;")
    - var activeSocialsCount = Object.values(socialSettings || {}).filter(Boolean).length

    div(style="border-bottom: 2px solid var(--border-color); padding-bottom: 10px; margin-bottom: 12px; display: flex; align-items: center; justify-content: space-between; gap: 8px;")
        div(style="display: flex; align-items: center; gap: 8px;")
            i.fa-solid.fa-share-nodes(style="color: var(--color-primary); font-size: 16px;")
            span(style="font-weight: 700; color: var(--text-main); text-transform: uppercase; font-size: 13px; letter-spacing: 0.5px;") Auto-Share
        span#active-socials-badge.admin-pill.is-success #{activeSocialsCount}

    p(style="font-size: 12.5px; color: var(--text-muted); margin-bottom: 14px; line-height: 1.45;")
        | Automatyczna dystrybucja nowych artykułów publicznych w mediach społecznościowych.

    if SERVICE_SOCIALS && SERVICE_SOCIALS.length > 0
        div(style="display: flex; flex-direction: column; gap: 8px;")
            each soc in SERVICE_SOCIALS
                - var isEnabled = socialSettings && socialSettings[soc.id] === true
                .admin-social-row(style="padding: 10px 12px; gap: 10px;")
                    div(style="display: flex; align-items: center; gap: 10px; min-width: 0;")
                        a.social-pill-link(href=soc.url title="Przejdź do serwisu " + soc.id target="_blank" style=`color: ${soc.color}; flex-shrink: 0;`)
                            i(class=soc.icon)
                        div(style="min-width: 0;")
                            div(style="font-size: 13.5px; font-weight: 700; color: var(--text-main); text-transform: capitalize; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;") #{soc.id}
                            span.social-status-label(id=`social-status-${soc.id}` style=`font-size: 11px; font-weight: 700; color: ${isEnabled ? 'var(--alert-success-text)' : 'var(--alert-danger-text)'};`)
                                | #{isEnabled ? 'AKTYWNE' : 'WYŁĄCZONE'}

                    label.switch(title="Przełącz automatyczne udostępnianie")
                        input(
                            type="checkbox"
                            checked=isEnabled
                            onchange=`toggleSocialShareSlider(this, '${soc.id}')`
                        )
                        span.slider
    else
        .no-posts.empty-state-box Brak zdefiniowanych serwisów w config.js (SERVICE_SOCIALS).
