if queryError === 'server'
    .admin-alert-box.is-danger(style="margin-bottom: 16px;")

        | ⚠️ #{customMsg || 'Błąd przetwarzania danych rachunku bankowego.'}

if queryMsg === 'user_approved'
    .admin-alert-box.is-success(style="margin-bottom: 16px;")
        | 🎉 Profil użytkownika został pomyślnie zweryfikowany, a powiadomienie wysłane.

if queryMsg === 'user_rejected'
    .admin-alert-box.is-danger(style="margin-bottom: 16px;")
        | ✕ Weryfikacja konta została odrzucona. Wysłano maila z uzasadnieniem.

if pendingUsers && pendingUsers.length > 0
    div(style="display: flex; flex-direction: column; gap: 20px;")
        each pUser in pendingUsers
            .post-card.admin-subcard.is-info-accent
                div(style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; flex-wrap: wrap; gap: 8px;")
                    div
                        h4(style="margin:0; font-size:16px; color: var(--text-main);") Użytkownik: <b>#{pUser.name}</b>
                        span(style="font-size:12px; color: var(--text-muted);")
                            | Oczekiwany Tytuł przelewu: 
                            span.admin-code-chip #{pUser.verificationTransferCode}
                    span.admin-pill.is-info(style="padding: 4px 10px;") OCZEKUJE NA SPRAWDZENIE ⏳

                form.admin-approve-form.admin-form-box(action=`/admin/verify-user/${pUser._id}/approve` method="POST" style="margin-bottom:12px;")
                    input(type="hidden" name="_csrf" value=csrfToken)
                    label(style="font-size:12px; font-weight:bold; color: var(--text-muted); display:block; margin-bottom:4px;") Przepisz numer konta nadawcy z wyciągu bankowego (system automatycznie zweryfikuje sumę kontrolną):
                    div(style="display:flex; gap:8px;")
                        input(type="text" name="bankAccount" placeholder="np. 26 cyfr rachunku nadawcy (spacje są dozwolone)" required style="flex:1; padding:8px; border:1px solid var(--border-input); border-radius:6px; outline:none; font-size:14px;")
                        button(type="submit" style="background:#146c43; color:white; border:none; padding:8px 16px; border-radius:6px; font-weight:bold; cursor:pointer; font-size:13px;") ✓ Zatwierdź Profil

                form.admin-form-box.is-danger(action=`/admin/verify-user/${pUser._id}/reject` method="POST")
                    input(type="hidden" name="_csrf" value=csrfToken)
                    label(style="font-size:12px; font-weight:bold; color: var(--alert-danger-text); display:block; margin-bottom:4px;") Odrzucenie przelewu (Wpisz powód, który zostanie dołączony do maila użytkownika):
                    textarea(name="adminComment" placeholder="Wpisz np. 'Konto bankowe powiązane z innym kontem fizycznym' lub 'Błędna kwota przelewu'..." style="width:100%; height:60px; padding:8px; border:1px solid var(--alert-danger-border); border-radius:6px; resize:none; font-family:inherit; font-size:13px; margin-bottom:8px; outline:none;")
                    button(type="submit" style="background:#bc2525; color:white; border:none; padding:8px 16px; border-radius:6px; font-weight:bold; cursor:pointer; font-size:13px;") ✕ Odrzuć Weryfikację
else
    .no-posts.empty-state-box Brak oczekujących przelewów weryfikacyjnych w systemie.
