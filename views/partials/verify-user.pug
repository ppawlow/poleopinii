if queryError === 'server'
    div(style="color: #bc2525; background: #fff3f3; padding: 12px; border-radius: 6px; margin-bottom: 16px; font-size: 14px; font-weight: 600;") 

        | ⚠️ #{customMsg || 'Błąd przetwarzania danych rachunku bankowego.'}

if queryMsg === 'user_approved'
    div(style="color: #42b72a; background: #f0fdf4; padding: 12px; border-radius: 6px; margin-bottom: 16px; font-size: 14px; font-weight: 600;") 
        | 🎉 Profil użytkownika został pomyślnie zweryfikowany, a powiadomienie wysłane.

if queryMsg === 'user_rejected'
    div(style="color: #bc2525; background: #fff3f3; padding: 12px; border-radius: 6px; margin-bottom: 16px; font-size: 14px; font-weight: 600;") 
        | ✕ Weryfikacja konta została odrzucona. Wysłano maila z uzasadnieniem.

if pendingUsers && pendingUsers.length > 0
    div(style="display: flex; flex-direction: column; gap: 20px;")
        each pUser in pendingUsers
            .post-card(style="border-left: 4px solid #1877f2; padding: 20px; background: #fff; border-radius: 8px; box-shadow: 0 1px 2px rgba(0,0,0,0.05);")
                div(style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;")
                    div
                        h4(style="margin:0; font-size:16px; color:#1c1e21;") Użytkownik: <b>#{pUser.name}</b>
                        span(style="font-size:12px; color:#65676b;") Oczekiwany Tytuł przelewu: <span style="font-family:monospace; font-weight:bold; background:#e4e6eb; padding:2px 6px; border-radius:4px;">#{pUser.verificationTransferCode}</span>
                    span(style="background:#e7f3ff; color:#1877f2; padding:4px 10px; border-radius:20px; font-size:12px; font-weight:bold;") OCZEKUJE NA SPRAWDZENIE ⏳

                form.admin-approve-form(action=`/admin/verify-user/${pUser._id}/approve` method="POST" style="background:#f0f2f5; padding:12px; border-radius:6px; margin-bottom:12px; display:block;")
                    input(type="hidden" name="_csrf" value=csrfToken)
                    label(style="font-size:12px; font-weight:bold; color:#65676b; display:block; margin-bottom:4px;") Przepisz numer konta nadawcy z wyciągu bankowego (system automatycznie zweryfikuje sumę kontrolną):
                    div(style="display:flex; gap:8px;")
                        input(type="text" name="bankAccount" placeholder="np. 26 cyfr rachunku nadawcy (spacje są dozwolone)" required style="flex:1; padding:8px; border:1px solid #dddfe2; border-radius:6px; outline:none; font-size:14px;")
                        button(type="submit" style="background:#146c43; color:white; border:none; padding:8px 16px; border-radius:6px; font-weight:bold; cursor:pointer; font-size:13px;") ✓ Zatwierdź Profil

                form(action=`/admin/verify-user/${pUser._id}/reject` method="POST" style="background:#fff3f3; padding:12px; border-radius:6px; display:block;")
                    input(type="hidden" name="_csrf" value=csrfToken)
                    label(style="font-size:12px; font-weight:bold; color:#bc2525; display:block; margin-bottom:4px;") Odrzucenie przelewu (Wpisz powód, który zostanie dołączony do maila użytkownika):
                    textarea(name="adminComment" placeholder="Wpisz np. 'Konto bankowe powiązane z innym kontem fizycznym' lub 'Błędna kwota przelewu'..." style="width:100%; height:60px; padding:8px; border:1px solid #f5c6cb; border-radius:6px; resize:none; font-family:inherit; font-size:13px; margin-bottom:8px; outline:none;")
                    button(type="submit" style="background:#bc2525; color:white; border:none; padding:8px 16px; border-radius:6px; font-weight:bold; cursor:pointer; font-size:13px;") ✕ Odrzuć Weryfikację
else
    .no-posts(style="text-align: center; padding: 32px; color: #65676b; background: #f0f2f5; border-radius: 6px;") Brak oczekujących przelewów weryfikacyjnych w systemie.
