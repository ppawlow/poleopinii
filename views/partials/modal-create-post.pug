//- Uniwersalny modal tworzenia nowego posta / polemiki
if user
    #create-post-modal.custom-modal-backdrop(style="display: none; align-items: flex-start; overflow-y: auto; padding: 30px 12px;" onclick="window.safeCancelInlineEdit('new')")
        .custom-modal-box(style="max-width: 680px; width: 100%; margin: auto;" onclick="event.stopPropagation()")
            .custom-modal-header(style="display: flex; justify-content: space-between; align-items: center; gap: 12px;")
                div(style="display: flex; align-items: center; gap: 12px; min-width: 0;")
                    button(type="button" onclick="window.safeCancelInlineEdit('new')" title="Anuluj i zamknij" style="background: none; border: none; font-size: 24px; font-weight: bold; color: var(--text-muted); cursor: pointer; padding: 0 4px; line-height: 1;") &times;
                    img.nav-avatar(src=(user.avatarUrl || '/uploads/default-avatar.png') style="width: 36px; height: 36px; flex-shrink: 0;")
                    .author-info(style="min-width: 0; overflow: hidden;")
                        h3(style="font-size: 15px; font-weight: 700; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;") #{user.name}
                        span#create-post-context-time.post-time(style="font-size: 12px; color: var(--text-muted); display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;") Tworzenie nowego wpisu
                
                button.modal-header-submit-btn(type="submit" form="editForm-new" style="background: #1877f2; color: white; border: none; padding: 8px 18px; border-radius: 20px; font-weight: 600; cursor: pointer; font-size: 14px; flex-shrink: 0;") Zapisz
            
            .custom-modal-body(style="padding: 16px;")
                - var activePost = { _id: 'new', title: '', visibility: 'private' }
                include edit.pug
