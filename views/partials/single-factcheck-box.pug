if factCheckReports && factCheckReports.length > 0
    each report in factCheckReports
        if !report.hasFactCheckErrors
            //- Wersja kompaktowa (gdy brak zastrzeżeń)
            section.ai-factcheck-highlight-box(id=`factcheck-report-item-${report._id}` style="margin-top: 28px; padding: 12px 16px; background: var(--alert-success-bg); border: 1px solid var(--alert-success-border); border-left: 4px solid var(--alert-success-text); border-radius: 8px; font-family: sans-serif; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;")
                div(style="display: flex; align-items: center; gap: 10px; color: var(--alert-success-text); font-size: 14px; font-weight: 600;")
                    i.fa-solid.fa-circle-check(style="font-size: 16px; flex-shrink: 0;")
                    span Weryfikacja faktograficzna AI: nie wykryto zastrzeżeń (#{report.createdAt ? new Date(report.createdAt).toLocaleDateString('pl-PL') : ''}).
                if user && user.role === 'editor'
                    button.btn-danger-soft(
                        type="button"
                        onclick=`window.executeEditorDeleteFactCheckReport('${report._id}')`
                        title="Usuń raport faktograficzny AI"
                        style="padding: 3px 8px; border-radius: 6px; font-size: 11.5px; font-weight: 600; cursor: pointer; flex-shrink: 0; display: inline-flex; align-items: center; gap: 4px;"
                    )
                        i.fa-solid.fa-trash-can
                        span Usuń
        else
            //- Wersja rozwinięta (gdy wykryto błędy lub manipulacje)
            section.ai-factcheck-highlight-box(id=`factcheck-report-item-${report._id}` style="margin-top: 32px; padding: 18px 20px; background: var(--alert-danger-bg); border: 1px solid var(--alert-danger-border); border-left: 5px solid var(--alert-danger-text); border-radius: 10px; font-family: sans-serif; box-shadow: 0 2px 8px rgba(188, 37, 37, 0.08);")
                div(style="display: flex; align-items: center; gap: 8px; margin-bottom: 10px; font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.6px; color: var(--alert-danger-text);")
                    i.fa-solid.fa-scale-balanced(style="font-size: 15px;")
                    span Weryfikacja Faktograficzna AI – Wykryto Zastrzeżenia
                div(style="display: flex; flex-direction: column; gap: 6px;")
                    div(style="display: flex; justify-content: space-between; align-items: flex-start; gap: 12px;")
                        a(href=`/posts/${report._id}` style="font-size: 17px; font-weight: 700; color: var(--alert-danger-text); text-decoration: none; line-height: 1.35;") #{report.title}
                        if user && user.role === 'editor'
                            button.btn-danger-soft(
                                type="button"
                                onclick=`window.executeEditorDeleteFactCheckReport('${report._id}')`
                                title="Usuń raport faktograficzny AI"
                                style="padding: 4px 10px; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer; flex-shrink: 0; display: inline-flex; align-items: center; gap: 5px;"
                            )
                                i.fa-solid.fa-trash-can
                                span Usuń raport
                    div(style="font-size: 12.5px; color: var(--text-muted); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;")
                        span Opracowanie: <b>#{report.author}</b> • #{report.createdAt ? new Date(report.createdAt).toLocaleDateString('pl-PL') : ''}
                        a(href=`/posts/${report._id}` style="background: #bc2525; color: #ffffff; padding: 4px 12px; border-radius: 14px; font-size: 12px; font-weight: 600; text-decoration: none;") Czytaj pełny raport →
