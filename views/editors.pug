extends layout

block content
    .main-container
        aside.left-sidebar
            div(style="border-bottom: 1px solid var(--border-color); padding-bottom: 8px; margin-bottom: 12px; display: flex; align-items: center; gap: 12px;")
                i.fa-solid.fa-user-shield(style="color: #9360f7;")
                span(style="font-weight: 700; color: var(--text-main); text-transform: uppercase; font-size: 13px; letter-spacing: 0.5px;") Zespół Redakcyjny
                
            if editorsList && editorsList.length > 0
                each ed in editorsList
                    a.sidebar-item(href=getProfileUrl({ _id: ed._id, alias: ed.alias || null }) style="text-decoration:none; color:inherit; display:flex; align-items:center; gap:12px; padding: 6px 8px;")
                        img.nav-avatar(src=(ed.avatarUrl || DEFAULT_ASSETS.avatar) style="width:28px; height:28px; object-fit: cover; border: 1px solid #9360f7;")
                        span(style="font-size: 14px; font-weight: 600; color: var(--text-main);") #{ed.name}
            else
                p(style="font-size: 12px; color: var(--text-muted); padding: 8px 12px; font-style: italic;") Brak zarejestrowanych redaktorów.
        
        main.feed
            .create-post.editors-room-banner
                h3(style="font-size: 14px; font-weight: 700; color: var(--color-accent); margin: 0; font-family: sans-serif;") 📝 Pokój Narad Redakcji
                p(style="font-size: 12px; color: var(--text-muted); margin: 2px 0 0 0;") Posty oraz dyskusje prowadzone w tej sekcji są całkowicie poufne i widoczne wyłącznie dla zespołu Redaktorów.

            include partials/create-post.pug

            #accordion-posts-wrapper.accordion-container
                if posts && posts.length > 0
                    each post in posts
                        include partials/post-card.pug
                else
                    .no-posts.empty-state-box(style="font-style: italic;") Brak wewnętrznych wpisów redakcyjnych. Stwórz pierwszy post powyżej!

            if hasMore
                #load-more-container(style="text-align: center; margin-top: 20px;")
                    button#load-more-btn.action-btn(onclick="loadMorePosts()" style="border: 1px solid var(--border-input); color: var(--color-accent);") Pokaż więcej

        aside.right-sidebar
            a.sidebar-item(href="/topics" style="text-decoration: none; color: inherit; margin-bottom: 12px; border-bottom: 2px solid var(--border-color); padding-bottom: 8px; display: flex; align-items: center; gap: 12px;")
                i.fa-solid.fa-newspaper(style="color: var(--color-primary);")
                span(style="font-weight: 700; color: var(--text-main); text-transform: uppercase; font-size: 14px; letter-spacing: 0.5px;") Przegląd dnia

            include partials/news-feed.pug
