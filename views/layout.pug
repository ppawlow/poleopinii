doctype html
html(lang="pl")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        meta(name="csrf-token" content=csrfToken)
        
        - var metaDescription = (post && post.content && typeof generatePostExcerpt === 'function') ? generatePostExcerpt(post.content, 160) : ("Przeczytaj najnowsze publicystyki i opinie w serwisie " + SERVICE_NAME)
        - var metaTitle = post && post.title ? post.title : title ? title + ' | ' + SERVICE_NAME : SERVICE_NAME
        - var metaImage = (post && post.imageUrl) ? (windowOrigin ? windowOrigin + post.imageUrl : post.imageUrl) : (windowOrigin ? windowOrigin + OG_DEFAULT_IMAGE : OG_DEFAULT_IMAGE)

        //- Tagi Open Graph (Facebook, LinkedIn, Messenger)
        meta(property="og:type" content="article")
        meta(property="og:url" content=(windowOrigin + currentUrl))
        meta(property="og:title" content=metaTitle)
        meta(property="og:description" content=metaDescription)
        meta(property="og:image" content=metaImage)
        if !post || !post.imageUrl
            meta(property="og:image:width" content="1200")
            meta(property="og:image:height" content="630")
        
        //- Tagi Twitter Cards / X
        meta(name="twitter:card" content="summary_large_image")
        meta(name="twitter:title" content=metaTitle)
        meta(name="twitter:description" content=metaDescription)
        meta(name="twitter:image" content=metaImage)
        meta(name="twitter:image:alt" content=metaTitle)

        title #{title ? SERVICE_NAME + ' | ' + title : SERVICE_NAME}

        link(rel="stylesheet" href="/quill/quill.snow.css")
        script(src="/quill/quill.js")
        
        link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css")
        script(src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js")

        script(src="https://www.google.com/recaptcha/enterprise.js?render=" +    RECAPTCHA_SITE_KEY)        
        script.
            window.env = { 
                RECAPTCHA_SITE_KEY: "!{RECAPTCHA_SITE_KEY}",
                useRecaptcha: !{useRecaptcha || false}
            };
        // link(rel="stylesheet" href="/css/style.css")
        link(rel="stylesheet" href="/css/global.css?v=2.0")
        link(rel="stylesheet" href="/css/mobile.css?v=2.0")
        link(rel="shortcut icon" href=FAVICON)
        // link(rel="stylesheet" href="https://cloudflare.com")
        
        script(src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js")

        // Podpięcie wspólnego pliku akordeonów i komentarzy
        script(src="/js/accordion.js")
        script(src="/js/mainApi.js")
        script(src="https://kit.fontawesome.com/8861df8022.js" crossorigin="anonymous")
        script(src="/js/feed.js")
        if user && user.role === 'editor'
            script(src="/js/editorsApi.js")
            
            
        block head
    body
        if user
            script.
                window.appUser = { 
                    id: "!{user.id || user._id}",
                    displayName: "!{user.displayName || user.name}",
                    avatarUrl: "!{user.avatarUrl || DEFAULT_ASSETS.avatar}",
                    isVerified: !{user.isFullyVerified} 
                };
        
        header.fb-navbar
            .nav-left
                include partials/logotype.pug
            .nav-center
                include partials/navigation.pug
            
            .nav-right
                if user
                    .user-visitcard
                        a.user-nav-link(
                            href=getProfileUrl(user) 
                            style="display:flex; align-items:center; gap:8px; text-decoration:none; color:inherit; height:100%; padding:0 8px;"
                            class=(currentTab === 'profile' ? 'active-profile' : '')
                        )
                            img.nav-avatar(src=(user.avatarUrl || DEFAULT_ASSETS.avatar) alt="Avatar")
                            span.user-name #{user.displayName}
                                if user.isFullyVerified
                                    sup(title="Profil Zweryfikowany" style="color: #1877f2; display: inline-flex;") 
                                        i.fa-solid.fa-circle-check
                                else
                                    sup(title="Profil Niezweryfikowany" style="color: var(--text-muted); display: inline-flex;") 
                                        i.fa-solid.fa-circle-xmark
                
                include partials/menu.pug

        .mobile-panel-indicator(aria-hidden="true")
            .panel-segment.seg-left
            .panel-segment.seg-center.active
            .panel-segment.seg-right

        .page-main-content
            if !user && currentTab
                .guest-top-prompt
                    h4(style="font-size: 15px; color: var(--text-main); font-family: sans-serif;") Chcesz współtworzyć naszą społeczność? Zapraszamy!
                        br
                        a(href="/auth/login" title="Logowanie" style="color: #1877f2; text-decoration: none; font-weight: bold;") Zaloguj się 
                        |  lub 
                        a(href="/auth/register" title="Rejestracja" style="color: #42b72a; text-decoration: none; font-weight: bold;") Utwórz konto

            block content

        footer.site-footer
            .footer-container(style="max-width: 1000px; margin: 0 auto; padding: 0 16px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;")
                div(style="font-size: 13px; color: var(--text-muted); font-weight: 500; min-width: 280px;")
                    | © 2026 #{SERVICE_NAME}. Wszelkie prawa zastrzeżone. Wydawca: 
                    a(href="https://kooporg.pl" target="_blank" style="color: inherit; text-decoration: none;") Kooperatywa Pracy Organicznej.
                
                div(style="display: flex; gap: 20px; align-items: center; justify-content: center;")
                    a(href="/regulamin" style="font-size: 12px; color: #1877f2; text-decoration: none; font-weight: 600;") ⚖️ Regulamin
                    a(href="/polityka-prywatnosci" style="font-size: 13px; color: #1877f2; text-decoration: none; font-weight: 600;") 🛡️ Polityka prywatności
                    a(href="#" onclick="event.preventDefault(); window.openAboutModal();" style="font-size: 13px; color: #1877f2; text-decoration: none; font-weight: 600;") ⓘ O aplikacji
                if useRecaptcha
                    div(style="font-size: 12px; color: var(--text-muted); text-align: center; width: 100%; margin-top: 6px; line-height: 1.4; font-family: sans-serif;")
                        | Witryna jest chroniona mechanizmem reCAPTCHA Enterprise. Obowiązuje 
                        a(href="https://google.com" target="_blank" style="color: #1877f2; text-decoration: none; font-weight: 600; margin: 0 4px;") Polityka prywatności
                        |  oraz 
                        a(href="https://google.com" target="_blank" style="color: #1877f2; text-decoration: none; font-weight: 600; margin-left: 4px;") Warunki świadczenia usług
                        |  Google

        #cookie-law-banner.cookie-banner-box
            div(style="display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;")
                p(style="font-size: 13px; color: var(--text-body); margin: 0; line-height: 1.4; flex: 1; min-width: 250px;")
                    | 🍪 Nasz serwis wykorzystuje techniczne pliki cookies w celu utrzymania sesji logowania oraz ochrony przed atakami (CSRF). Pozostając na stronie, wyrażasz zgodę na ich stosowanie. Szczegóły znajdziesz w 
                    a(href="/polityka-prywatnosci" style="color: #1877f2; font-weight: bold; text-decoration: underline;") Polityce prywatności.
                button(type="button" onclick="window.acceptCookieLaw()" style="background: #42b72a; color: white; border: none; padding: 8px 16px; border-radius: 6px; font-weight: 600; font-size: 13px; cursor: pointer; white-space: nowrap;") Rozumiem
        
        include partials/modal.pug
