extends layout

block append head
    link(rel="stylesheet" href="/css/profile.css?v=1")
    script(src="/js/profileApi.js")
    script(src="/js/authApi.js")

block content
    .main-container(style="grid-template-columns: 1fr; max-width: 600px; margin: 0 auto;")
        main.feed
            div(style="margin-bottom: 8px;")
                a(href=`/profile/${user.id}` style="text-decoration: none; color: #1877f2; font-weight: 600; font-size: 14px; display: inline-flex; align-items: center; gap: 6px;")
                    i.fa-solid.fa-arrow-left
                    | Powrót do profilu

            include partials/settings-profile-form.pug
            include partials/settings-security-rodo.pug

    include partials/settings-modals.pug
