extends layout

block content
    .main-container(style="grid-template-columns: 1fr; max-width: 750px; margin: 0 auto;")
        main.feed
            .create-post(style="padding: 24px;")
                h2(style="margin-bottom: 20px; color: var(--text-main); font-size: 22px; font-weight: 700;") 🔔 Powiadomienia i aktywność konta

                #events-list-wrapper(style="display: flex; flex-direction: column; gap: 12px;")
                    if events && events.length > 0
                        each ev in events
                            include partials/event-row.pug
                    else
                        .no-posts.empty-state-box Nie masz jeszcze żadnych powiadomień systemowych.
