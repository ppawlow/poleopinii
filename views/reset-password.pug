extends layout

block append head
    link(rel="stylesheet" href="/css/auth.css?v=1")
    script(src="/js/authApi.js")

block content
    .login-container
        .login-branding
            img(src=LOGOTYP width="100%")
        
        .login-box
            if isInitial
                h3 Ustaw hasło dostępu
                p(style="font-size: 12px; color: var(--text-muted); margin-bottom: 14px;") Wprowadź bezpieczne hasło dla swojego konta (min. 8 znaków, duża i mała litera oraz cyfra).
            else
                h3 Ustaw nowe hasło dostępu
            
            if error === 'mismatch'
                .admin-alert-box.is-danger(style="margin-bottom: 16px; font-size: 13px;") ⚠️ Wpisane hasła nie są identyczne.
            if error === 'weak_password'
                .admin-alert-box.is-danger(style="margin-bottom: 16px; font-size: 13px;") ⚠️ Hasło nie spełnia kryteriów bezpieczeństwa (min. 8 znaków, duża i mała litera oraz cyfra).

            form(action=`/auth/set-password/${token}` method="POST")
                input(type="hidden" name="_csrf" value=csrfToken)
                
                label(style="font-size: 13px; color: var(--text-muted); display: block; margin-bottom: 6px;") Nowe hasło:
                div(style="position: relative; width: 100%;")
                    input#resetPasswordField(type="password" name="password" required placeholder="Minimum 8 znaków" style="width: 100%; padding-right: 40px;")
                    i.fa-regular.fa-eye#toggleResetPassword(style="position: absolute; right: 12px; top: 14px; cursor: pointer; color: var(--text-muted);")

                label(style="font-size: 13px; color: var(--text-muted); display: block; margin-bottom: 6px; margin-top: 12px;") Powtórz nowe hasło:
                div(style="position: relative; width: 100%;")
                    input#confirmPasswordField(type="password" name="confirmPassword" required placeholder="Wpisz hasło ponownie" style="width: 100%; padding-right: 40px;")
                    i.fa-regular.fa-eye#toggleConfirmPassword(style="position: absolute; right: 12px; top: 14px; cursor: pointer; color: var(--text-muted);")
                
                if isInitial
                    button.login-submit(type="submit" style="font-size: 16px; margin-top: 16px; background-color: #42b72a;") Aktywuj konto i zaloguj
                else
                    button.login-submit(type="submit" style="font-size: 16px; margin-top: 16px;") Zapisz nowe hasło
