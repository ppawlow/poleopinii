extends base-layout

block email-config
  - var borderTopColor = '#1877f2'

block email-body
  h2(style="color: #1c1e21; margin-top: 0; font-size: 20px; font-weight: 700; margin-bottom: 16px;") Zmiana hasła dostępu
  p(style="font-size: 15px; color: #050505; line-height: 1.5; margin: 0 0 12px 0;") Dzień dobry,
  p(style="font-size: 15px; color: #050505; line-height: 1.5; margin: 0 0 20px 0;") Zarejestrowaliśmy prośbę o zresetowanie hasła w serwisie #{serviceName}. Jeśli to nie Ty wysłałeś zapytanie, zignoruj tę wiadomość. Aby ustawić nowe hasło, kliknij w poniższy odnośnik:
  
  table(cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 20px;")
    tr
      td
        a(href=resetLink style="display: inline-block; background-color: #1877f2; color: #ffffff; font-weight: bold; padding: 12px 24px; border-radius: 6px; text-decoration: none; font-size: 15px;") Ustaw nowe hasło
