extends base-layout

block email-config
  - var borderTopColor = '#bc2525'

block email-body
  h2(style="color: #bc2525; margin-top: 0; font-size: 20px; font-weight: 700; margin-bottom: 16px;") ⛔ Tymczasowe zawieszenie konta
  p(style="font-size: 15px; color: #050505; line-height: 1.5; margin: 0 0 12px 0;") Witaj #[strong #{userName}],
  p(style="font-size: 15px; color: #050505; line-height: 1.5; margin: 0 0 12px 0;") Informujemy, że moderatorzy serwisu #[strong #{serviceName}] podjęli decyzję o czasowym zablokowaniu Twojego konta na okres #[strong #{durationDays} #{durationDays === 1 ? 'dnia' : 'dni'}] (do dnia #[strong #{untilFormatted}]).

  if reason && reason.trim().length > 0
    p(style="font-size: 14px; font-weight: bold; color: #1c1e21; margin: 16px 0 6px 0;") Uzasadnienie decyzji:
    div(style="background-color: #fff3f3; padding: 14px; border-radius: 6px; border-left: 4px solid #bc2525; color: #1c1e21; font-style: italic; font-size: 14px; line-height: 1.5; margin-bottom: 16px;")
      | #{reason}

  p(style="font-size: 15px; color: #050505; line-height: 1.5; margin: 0 0 12px 0;") Zgodnie z #[strong § 7 pkt 5 Regulaminu Serwisu], w okresie obowiązywania blokady:
  ul(style="font-size: 14px; color: #1c1e21; line-height: 1.6; margin: 0 0 16px 0; padding-left: 20px;")
    li interakcje z innymi użytkownikami (komentowanie, polemizowanie, ocenianie, obserwowanie oraz wysyłanie wiadomości prywatnych) są zablokowane,
    li nowe oraz edytowane treści mogą być zapisywane wyłącznie w strefie prywatnej.

  p(style="font-size: 13px; color: #65676b; line-height: 1.5; margin: 16px 0 0 0;") Pełne uprawnienia konta zostaną przywrócone automatycznie po upływie wskazanego terminu.
