extends base-layout

block email-config
  - var borderTopColor = '#9360f7'

block email-body
  h2(style="color: #9360f7; margin-top: 0; font-size: 20px; font-weight: 700; margin-bottom: 16px;") Nowy wątek w Pokoju Narad Redakcji
  p(style="font-size: 15px; color: #050505; line-height: 1.5; margin: 0 0 12px 0;") Dzień dobry,
  p(style="font-size: 15px; color: #050505; line-height: 1.5; margin: 0 0 12px 0;") Redaktor #[strong #{editorName}] otworzył nowy, wewnętrzny temat krytyczny w strefie Kolegium: #[strong "#{postTitle}"].
  p(style="font-size: 15px; color: #050505; line-height: 1.5; margin: 0 0 20px 0;") Treść oraz dyskusja wokół tego wątku mają charakter poufny.
  
  table(cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 10px;")
    tr
      td
        a(href=postUrl style="display: inline-block; background-color: #9360f7; color: #ffffff; font-weight: bold; padding: 11px 20px; border-radius: 6px; text-decoration: none; font-size: 14px;") Otwórz Pokój Narad
