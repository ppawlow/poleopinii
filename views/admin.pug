//- views/admin.pug
extends layout
include partials/dataTable.pug

block append head
    link(rel="stylesheet" href="/css/admin.css?v=1")
    script(src="/js/adminApi.js")

mixin adminSection(panelId, iconClass, titleText, titleColor, badgeText, badgeClass, isOpen, isCardBg, tableTrigger, badgeId)
    .post-card.accordion-item.admin-panel-card(id=panelId)
        .accordion-header.admin-panel-header(data-table-trigger=tableTrigger)
            h3(style=`font-size: 16px; font-weight: 700; color: ${titleColor}; margin: 0; display: inline-flex; align-items: center; gap: 8px;`)
                i(class=iconClass)
                | #{titleText}
            div(style="display: flex; align-items: center; gap: 12px;")
                span.admin-pill(id=badgeId class=badgeClass) #{badgeText}
                i.fa-solid.fa-chevron-down.accordion-icon(style=`color: var(--text-muted); transition: transform 0.3s;${isOpen ? ' transform: rotate(180deg);' : ''}`)
        .accordion-content.admin-panel-body(class=(isCardBg ? 'is-card-bg' : '') style=(isOpen ? 'display: block;' : 'display: none;'))
            block

block content
    - var hasReports = reports && reports.length > 0

    .main-container
        aside.left-sidebar
            include partials/admin-server-status.pug

        main.feed
            .create-post(style="padding: 24px; margin-bottom: 8px;")
                h2(style="margin-bottom: 4px; color: var(--alert-danger-text); font-size: 22px; font-weight: 700;") Panel Administratora
                p(style="font-size: 14px; color: var(--text-muted); margin-bottom: 0;") Zarządzaj zgłoszeniami nadużyć, procesami uwierzytelniania, użytkownikami oraz logami bezpieczeństwa.

            .accordion-container(style="display: flex; flex-direction: column; gap: 12px; width: 100%;")
                +adminSection("admin-panel-abuse", "fa-solid fa-triangle-exclamation", "Zgłoszenia nadużyć i moderacja treści", "var(--alert-danger-text)", reports.length, "is-danger", hasReports, false)
                    include partials/abuse.pug

                +adminSection("admin-panel-verify", "fa-solid fa-bank", "Oczekujące przelewy uwierzytelniające", "#1877f2", pendingUsers.length, "is-info", false, false)
                    include partials/verify-user.pug

                +adminSection("admin-panel-users", "fa-solid fa-users", "Rejestr i aktywność użytkowników", "var(--text-main)", systemUsers.length, "", false, true, "usersTable")
                    include partials/admin-users.pug

                +adminSection("admin-panel-logs", "fa-solid fa-scroll", "Logi operacyjne i audyt użycia AI", "var(--text-main)", logs.length, "", false, true, "logsTable")
                    include partials/admin-logs.pug

                +adminSection("admin-panel-analytics", "fa-solid fa-chart-line", "Statystyki ruchu i odwiedzin serwisu", "#1877f2", `${analytics.todayStats.totalVisits} dziś`, "is-info", false, true)
                    include partials/admin-analytics.pug

                - var bannedCount = (bannedIps || []).length
                +adminSection("admin-panel-banned-ips", "fa-solid fa-ban", "Zablokowane adresy IP (Bot Trap)", "var(--alert-danger-text)", bannedCount, bannedCount > 0 ? "is-danger" : "", false, true, null, "banned-ips-badge")
                    include partials/admin-banned-ips.pug

        aside.right-sidebar
            include partials/admin-socials.pug

    include partials/modal-suspend-user.pug
