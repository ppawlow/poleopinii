//- views/admin.pug
extends layout
block append head
    //- Dołączenie jQuery oraz DataTables z CDN
    link(href="https://cdn.datatables.net/2.3.6/css/dataTables.dataTables.min.css", rel='stylesheet')
    script(src="https://cdn.datatables.net/2.3.6/js/dataTables.min.js")

    link(href="https://cdn.datatables.net/fixedheader/4.0.5/css/fixedHeader.dataTables.min.css",    rel='stylesheet')
    script(src="https://cdn.datatables.net/fixedheader/4.0.5/js/dataTables.fixedHeader.min.js")
    //Select
    link(rel="stylesheet" href="https://cdn.datatables.net/select/3.1.3/css/select.dataTables.min.css")
    script(src="https://cdn.datatables.net/select/3.1.3/js/dataTables.select.min.js")
    //Reseponsive
    link(rel="stylesheet" href="https://cdn.datatables.net/responsive/3.0.7/css/responsive.dataTables.min.css")
    script(src="https://cdn.datatables.net/responsive/3.0.7/js/dataTables.responsive.min.js")

    script(src="/js/adminApi.js")

block content
    .main-container(style="grid-template-columns: 1fr; max-width: 800px; margin: 0 auto;")
        main.feed
            .create-post(style="padding: 24px;")
                h2(style="margin-bottom: 12px; color: #bc2525; font-size: 22px; font-weight: 700;") ⚖️ Panel Zarządzania Systemem (Centrum Administracji)
                p(style="font-size: 14px; color: #65676b; margin-bottom: 24px;") Poniżej znajduje się zestawienie zgłoszeń nadużyć oraz procesów weryfikacji tożsamości społeczności platformy.

                //- INKLUDOWANIE PANELU ZGŁOSZEŃ NADUŻYĆ (abuse.pug)
                include partials/abuse.pug

                //- INKLUDOWANIE PANELU WERYFIKACJI UŻYTKOWNIKÓW (verify-user.pug posiada już wbudowane komunikaty)
                include partials/verify-user.pug
                
                //- INTEGRACJA SEGMENTU REJESTRU I STATYSTYK UŻYTKOWNIKÓW
                include partials/admin-users.pug

                //- INKLUDOWANIE PODWIDOKU LOGÓW OPERACYJNYCH I AUDYTU ZUŻYCIA AI (logs.pug)
                include partials/admin-logs.pug
