extends layout

block content
    - var isSingleView = true
    - var isWorkMode = false
    - var singleVisClass = post.visibility === 'users' ? 'is-users' : (post.visibility === 'editors' ? 'is-editors' : '')

    .main-container(style="grid-template-columns: 1fr; max-width: 800px; margin: 32px auto; padding: 0 20px;")
        main.editorial-article.portal-news-card.single-article-card(id=`post-${post._id}` class=singleVisClass)
            include partials/post-header-portal.pug

            .portal-single-content-wrapper(style="padding: 20px 32px 36px 32px;")
                hr(style="border: 0; border-top: 1px solid var(--border-color); margin: 0 0 24px 0;")
                include partials/post-body.pug
                include partials/single-author-box.pug
                include partials/single-abuse-reports.pug
                include partials/single-factcheck-box.pug
                include partials/single-related-posts.pug

                footer.article-footer(style="margin-top: 40px; padding-top: 20px; border-top: 1px solid var(--border-color); display: block; margin-bottom: 24px;")
                    include partials/post-footer.pug

            #custom-lightbox-modal.custom-lightbox-backdrop(style="display: none;" onclick="closeLightbox()")
                span.lightbox-close(onclick="closeLightbox()") &times;
                img#lightbox-target-image.lightbox-content(src="" alt="Powiększone zdjęcie")
