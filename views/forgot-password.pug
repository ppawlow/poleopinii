extends layout

block append head
    link(rel="stylesheet" href="/css/auth.css?v=1")
    script(src="/js/authApi.js")

block content
    .login-container
        .login-branding
            img(src=LOGOTYP width="100%")
        
        .login-box
            h3 Odzyskiwanie hasła
            
            if msg === 'sent'
                .admin-alert-box(style="background: var(--alert-info-bg); color: var(--alert-info-text); border: 1px solid var(--alert-info-border); margin-bottom: 16px; font-size: 13px;") ✉️ Jeśli podany e-mail istnieje w bazie, wysłaliśmy instrukcję resetowania hasła.
            if error === 'server'
                .admin-alert-box.is-danger(style="margin-bottom: 16px; font-size: 13px;") ⚠️ Błąd serwera. Spróbuj ponownie.

            form#forgotPasswordForm(action="/auth/forgot-password" method="POST")
                input(type="hidden" name="_csrf" value=csrfToken)
                input#forgotRecaptchaToken(type="hidden" name="recaptchaToken")
                label(style="font-size: 13px; color: var(--text-muted); display: block; margin-bottom: 6px;") Wpisz swój zarejestrowany adres e-mail:
                input(type="email" name="email" placeholder="Twój adres e-mail" required)
                button.login-submit(type="submit" style="font-size: 16px; margin-top: 6px;") Wyślij link resetujący
            
            hr
            div(style="text-align: center;")
                a(href="/auth/login" style="text-decoration: none; color: #1877f2; font-size: 14px; font-weight: 600;") Powrót do logowania
