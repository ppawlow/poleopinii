extends layout

block content
    .login-container
        .login-box
            img(src=LOGOTYP width="100%")
        
        .login-box
            h3 Odzyskiwanie hasła
            
            if msg === 'sent'
                div(style="color: #1877f2; background: #e7f3ff; padding: 12px; border-radius: 6px; margin-bottom: 16px; font-size: 13px; font-weight: 600;") ✉️ Jeśli podany e-mail istnieje w bazie, wysłaliśmy instrukcję resetowania hasła. Sprawdź konsolę serwera!
            if error === 'server'
                div(style="color: #bc2525; background: #fff3f3; padding: 12px; border-radius: 6px; margin-bottom: 16px; font-size: 13px; font-weight: 600;") ⚠️ Błąd serwera. Spróbuj ponownie.

            form(action="/auth/forgot-password" method="POST")
                input(type="hidden" name="_csrf" value=csrfToken)
                label(style="font-size: 13px; color: #65676b; display: block; margin-bottom: 6px;") Wpisz swój zarejestrowany adres e-mail:
                input(type="email" name="email" placeholder="Twój adres e-mail" required)
                button.login-submit(type="submit" style="font-size: 16px; margin-top: 6px;") Wyślij link resetujący
            
            hr
            div(style="text-align: center;")
                a(href="/auth/login" style="text-decoration: none; color: #1877f2; font-size: 14px; font-weight: 600;") Powrót do logowania
